@page "/cambiarcontrasena/{id}"
@using Models
@using Data
@using BCrypt.Net
@using System.Text.RegularExpressions
@inject NavigationManager NavigationManager
@inject UsuariosClient client

<PageTitle>Cambiar Contraseña - Staticaly</PageTitle>

<div class="text-white flex flex-col justify-center md:justify-normal items-center">
  @if (isLoading)
  {
    <div class="h-full absolute inset-0 flex justify-center items-center bg-black bg-opacity-50 z-50">
      <svg class="animate-spin h-8 w-8 text-primary-500" xmlns="http://www.w3.org/2000/svg" fill="none"
        viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647zM20 12a8 8 0 01-8 8v4c6.627 0 12-5.373 12-12h-4zm-2-5.291A7.962 7.962 0 0120 12h4c0-3.042-1.135-5.824-3-7.938l-3 2.647z">
        </path>
      </svg>
    </div>
  }
  <div id="logo" class="text-center md:mt-8 mb-4">
    <img src="images/heart.svg" class="w-24 h-24 mx-auto" alt="Logo de Statica.ly" />
    <h1 class="text-3xl text-logo-text">Statica.ly</h1>
  </div>
  <div class="bg-primary-300 rounded-lg p-8">
    @if (ErrorMessage != "")
    {
      <div class="px-5 py-2 bg-red-500 rounded-md font-bold text-xs text-white text-center max-w-full">
        <p>@ErrorMessage</p>
      </div>
    }
    <EditForm Model="@user" OnValidSubmit="Cambiar" class="flex flex-col text-primary-400">
      <div class="relative mt-3 bg-primary-100 rounded-md font-bold">
        <InputText @bind-Value="@user.Password" type="@GetPasswordType()" id="password"
          class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-12 placeholder-primary-400 bg-transparent"
          placeholder="Contraseña" />
        <ValidationMessage For="@(() => user.Password)" class="text-red-500" />
        <img src="images/llave.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"
          alt="Icono de llave" />
        <img src="images/ojo-abierto.svg" @onclick="TogglePasswordVisibility"
          class="absolute right-3 top-1/2 transform -translate-y-1/2 w-6 h-6 cursor-pointer @(showPassword ? "visible" : "hidden")"
          alt="Icono de ojo abierto" id="eyeOpen" />
        <img src="images/ojo-cerrado.svg" @onclick="TogglePasswordVisibility"
          class="absolute right-3 top-1/2 transform -translate-y-1/2 w-6 h-6 cursor-pointer @(showPassword ? "hidden" : "visible")"
          alt="Icono de ojo cerrado" id="eyeClosed" />
      </div>
      <div class="relative mt-3 bg-primary-100 rounded-md font-bold">
        <InputText @bind-Value="@ConfirmPassword" id="password"
          class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-12 placeholder-primary-400 bg-transparent"
          placeholder="ConfirmarContraseña" />
        <ValidationMessage For="@(() => user.Password)" class="text-red-500" />
        <img src="images/llave.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"
          alt="Icono de llave" />
      </div>
      @if (submitted && !ValidatePassword(user.Password))
              {
                  <div class="px-5 py-2 bg-red-500 rounded-md font-bold text-xs text-white text-left max-w-full">
                      <p class="mb-1">La contraseña debe contener al menos:</p>
                      <ul class="list-disc">
                        <li>Una mayúscula</li>
                        <li>Una minúscula</li>
                        <li>Un número</li>
                        <li>Seis caracteres como mínimo</li>
                      </ul>
                  </div>
              }
      <button type="submit" class="w-full h-12 mt-6 mb-3 bg-primary-500 rounded-md text-primary-100 hover:bg-primary-700 transition duration-300">Confirmar Cambio</button>
    </EditForm>
  </div>
</div>

@code {
    [Parameter] public string? id { get; set; }
    private string ConfirmPassword = "";
    private string ErrorMessage = "";
    private User user = new User();
    private bool showPassword = false;
    private bool submitted = false;
    private bool isLoading = false;

    private string GetPasswordType() => showPassword ? "text" : "password";

    private void TogglePasswordVisibility() => showPassword = !showPassword;

    private async Task Cambiar()
    {
      isLoading = true;
        submitted = true;
        if (!int.TryParse(id, out int userId))
        {
            ErrorMessage = "El enlace no es válido.";
            isLoading = false;
            return;
        }

        if (!ValidatePassword(user.Password))
        {
            Console.WriteLine("La contraseña debe tener al menos una mayúscula, una minúscula, un número y seis caracteres como mínimo.");
            isLoading = false;
            return;
        }
        if (user.Password != ConfirmPassword)
        {
            ErrorMessage = "Las contraseñas no coinciden.";
            isLoading = false;
            return;
        }

        user.Password = BCrypt.HashPassword(user.Password);

        await client.PasswordResetAsync(user.Password, userId);
        NavigationManager.NavigateTo("/");
    }

    private bool ValidatePassword(string? password)
    {
        if (string.IsNullOrWhiteSpace(password) || password.Length < 6)
        {
            return false;
        }

        // Utilizar expresiones regulares para validar la contraseña
        Regex regex = new Regex(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{6,}$");
        return regex.IsMatch(password);
    }
}

