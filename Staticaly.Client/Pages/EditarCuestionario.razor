@page "/editar-cuestionario/{CuestionarioID}/{UsuarioID}/{GrupoId}"
@using Models
@using Data
@using System.Net.Http
@inject NavigationManager NavigationManager
@inject CuestionarioClient CuestionarioClient
@inject PreguntasClient PreguntasClient
@inject OpcionesCuestionarioClient OpcionesClient

<PageTitle>Editar Cuestionario - Staticaly</PageTitle>

<div class="flex flex-col justify-center items-center text-primary-50 p-3">
  <h1 class="text-4xl font-bold mt-3">Editar Cuestionario</h1>
  @if (Cuestionario == null)
  {
    <p>Cargando...</p>
  }
  @if (!TituloGuardado)
  {
    <div class="mt-4 flex flex-col bg-primary-500 rounded-lg w-full lg:w-96 p-7">
      <label for="titulo" class="text-lg font-bold">Título del Cuestionario:</label>
      <input type="text" id="titulo" @bind="TituloCuestionario"
        class="border bg-primary-700 border-gray-300 rounded-md px-3 py-2 mt-1 focus:outline-none focus:border-primary-150" />
      <label for="descripcion" class="text-lg font-bold mt-2">Descripción del Cuestionario: (opcional)</label>
      <InputTextArea @bind-Value="DescripcionCuestionario"
        class="border bg-primary-700 border-gray-300 rounded-md px-3 py-2 mt-1 focus:outline-none focus:border-primary-150 h-48" />
      <button @onclick="() => GuardarTitulo()"
        class="bg-primary-800 hover:bg-primary-900 text-white font-bold py-2 px-4 rounded-md mt-2 focus:outline-none focus:shadow-outline">Guardar
        Título</button>
    </div>
  }
  @if (TituloGuardado)
  {

    <div class="mt-4 flex flex-col bg-primary-500 rounded-lg w-full md:w-[600px] p-7">
      <h3 class="text-md font-bold">Título del Cuestionario:</h3>
      <h4 class="text-lg font-bold">@TituloCuestionario</h4>
      <h3 class="text-md font-bold mt-2">Descripción del Cuestionario:</h3>
      <h4 class="text-lg font-bold">@DescripcionCuestionario</h4>
    </div>
    <div class="mt-4 flex flex-col items-center">
      <label for="pregunta" class="text-lg font-bold">Pregunta:</label>
      <input type="text" id="pregunta" @bind="NuevaPregunta"
        class="border bg-primary-700 border-gray-300 rounded-md px-3 py-2 mt-1 focus:outline-none focus:border-primary-150 w-96" />
      <button @onclick="() => AgregarPregunta()"
        class="bg-primary-800 hover:bg-primary-900 text-white font-bold py-2 px-4 rounded-md mt-2 focus:outline-none focus:shadow-outline">Agregar
        Pregunta
      </button>
    </div>
    @if (Preguntas != null && Preguntas.Any())
    {
      <h4 class="text-lg font-bold mt-4">Preguntas:</h4>
      @foreach (var pregunta in Preguntas)
      {
        <div class="mt-4 w-full flex flex-col items-center p-7 rounded-md bg-primary-500">
          <div class="flex justify-between w-full">
              <input type="text" @bind="pregunta.Pregunta"
                    class="text-lg font-bold border bg-primary-700 border-gray-300 rounded-md px-3 py-2 mt-1 focus:outline-none focus:border-primary-150 w-96" />

              <button @onclick="() => EliminarPregunta(pregunta.PreguntaID)"
                      class="bg-red-600 hover:bg-red-700 text-white font-bold py-1 px-2 rounded-md focus:outline-none focus:shadow-outline">Eliminar
              </button>
          </div>
          @if (pregunta.Opciones != null && pregunta.Opciones.Any())
          {
            <h5 class="text-md font-bold mt-2">Opciones:</h5>
            @foreach (var opcion in pregunta.Opciones)
            {
                <div class="mt-2 flex justify-between w-full">
                    <input type="text" value="@opcion.Opcion"
                          class="border bg-primary-700 border-gray-300 rounded-md px-3 py-2 mt-1 focus:outline-none focus:border-primary-150 w-96"
                          @oninput="(e) => { opcion.Opcion = e.Value?.ToString(); CambiarTextoOpcion(pregunta, opcion); }" />
                    <button @onclick="() => EliminarOpcion(pregunta, opcion)"
                            class="bg-red-600 hover:bg-red-700 text-white font-bold py-1 px-2 rounded-md focus:outline-none focus:shadow-outline">Eliminar
                    </button>
                </div>
            }
          }
          <div class="mt-2 flex justify-between w-full">
            <input type="text" @bind="NuevaOpcion"
              class="border bg-primary-700 border-gray-300 rounded-md px-3 py-2 mt-1 focus:outline-none focus:border-primary-150 w-96" />
            <button @onclick="() => AgregarOpcion(pregunta)"
              class="bg-green-600 hover:bg-green-700 text-white font-bold py-1 px-2 rounded-md focus:outline-none focus:shadow-outline">Agregar
            </button>
          </div>
        </div>
      }
    }
    <div class="mt-4" style="text-align:center">
        <button @onclick="GuardarCuestionario"
                class="@($"bg-Secondary-700 text-white font-bold py-2 px-4 rounded-md mt-2 focus:outline-none focus:shadow-outline {(CambiosRealizados ? string.Empty : "bg-gray-300 cursor-not-allowed")}")"
                disabled="@(!CambiosRealizados)">Guardar Cuestionario</button>
    </div>
  }
</div>

@code {
  [Parameter] public string? CuestionarioID { get; set; }
  [Parameter] public string? UsuarioID { get; set; }
  [Parameter] public string? GrupoId { get; set; }
  public Cuestionarios? Cuestionario { get; set; }
  public List<Preguntas>? Preguntas { get; set; }
  public string NuevaPregunta { get; set; } = "";
  public string TituloCuestionario { get; set; } = "";
  public string DescripcionCuestionario { get; set; } = "";
  private string NuevaOpcion { get; set; } = "";
  public bool TituloGuardado { get; set; } = false;
  public string MensajeError { get; set; } = "";
  public bool CambiosRealizados { get; set; } = false;


  protected override async Task OnInitializedAsync()
  {
    if (CuestionarioID != null)
    {
      Cuestionario = await CuestionarioClient.ObtenerCuestionarioPorIDAsync(int.Parse(CuestionarioID));
      TituloCuestionario = Cuestionario?.Titulo ?? "";
      DescripcionCuestionario = Cuestionario?.Descripcion ?? "";
      await CargarPreguntas();
      await CargarOpcionesParaTodasLasPreguntas();
    }
  }

  // Modifica el método CargarPreguntas para copiar las opciones originales
  private async Task CargarPreguntas()
  {
      if (CuestionarioID != null)
      {
          var preguntas = await PreguntasClient.GetPreguntasAsync(int.Parse(CuestionarioID));
          Preguntas = preguntas?.ToList();

          // Copiar las opciones originales
          if (Preguntas != null)
          {
              foreach (var pregunta in Preguntas)
              {
                  pregunta.OpcionesOriginales = pregunta.Opciones.Select(opcion => opcion.Opcion ?? "").ToList() ?? new List<string>();
              }
          }
      }
  }

  private async Task GuardarTitulo()
  {
    if (Cuestionario != null)
    {
      if (string.IsNullOrEmpty(TituloCuestionario))
      {
        return; // No se puede guardar un título vacío
      }
      // Actualizar el título y descripción del cuestionario
      Cuestionario.Titulo = TituloCuestionario;
      Cuestionario.Descripcion = DescripcionCuestionario;
      await CuestionarioClient.ActualizarCuestionarioAsync(Cuestionario);
      TituloGuardado = true;
    }
  }

  private async Task AgregarPregunta()
  {
    if (CuestionarioID != null)
    {
      // Crear la nueva pregunta
      var pregunta = new Preguntas
        {
          Pregunta = NuevaPregunta,
          CuestionarioID = int.Parse(CuestionarioID)
        };
      await PreguntasClient.CreatePreguntaAsync(pregunta);
      await CargarPreguntas(); // Recargar las preguntas después de agregar una nueva
      NuevaPregunta = ""; // Limpiar el campo de entrada
    }
  }

  private async Task GuardarPregunta(Preguntas pregunta)
  {
    await PreguntasClient.UpdatePreguntaAsync(pregunta);
  }

  private async Task GuardarOpcion(OpcionesCuestionario opcion)
  {
    await OpcionesClient.UpdateOpcionAsync(opcion);
  }

  private async Task GuardarCuestionario()
  {
      if (SePuedeGuardarCuestionario())
      {
          if (Cuestionario != null)
          {
              await GuardarTitulo(); // Guarda el título y descripción del cuestionario

              if (Preguntas != null)
              {
                  foreach (var pregunta in Preguntas)
                  {
                      await GuardarPregunta(pregunta); // Guarda cada pregunta

                      if (pregunta.Opciones != null)
                      {
                          foreach (var opcion in pregunta.Opciones)
                          {
                              await GuardarOpcion(opcion); // Guarda cada opción
                          }
                      }
                  }
              }

              // Redireccionar a la página de cuestionario
              if (UsuarioID != null && GrupoId != null)
              {
                  NavigationManager.NavigateTo($"/cuestionario/{UsuarioID}/{GrupoId}");
              }
          }
      }
      else
      {
          // Mostrar un mensaje de error si no se puede guardar el cuestionario
          MensajeError = "No se puede guardar el cuestionario. Asegúrate de que haya un título, al menos una pregunta y que cada pregunta tenga al menos dos opciones.";
      }
  }

  private bool SePuedeGuardarCuestionario()
  {
    if (string.IsNullOrEmpty(TituloCuestionario) || Preguntas == null || !Preguntas.Any())
    {
      return false; // Si no hay título o no hay preguntas, no se puede guardar el cuestionario
    }

    foreach (var pregunta in Preguntas)
    {
      if (pregunta.Opciones == null || pregunta.Opciones.Count < 2)
      {
        return false; // Si alguna pregunta no tiene al menos dos opciones, no se puede guardar el cuestionario
      }
    }

    return true; // Si todas las preguntas tienen al menos dos opciones, se puede guardar el cuestionario
  }

  private async Task EliminarPregunta(int preguntaId)
  {
    if (preguntaId != 0)
    {
      // Eliminar la pregunta
      await PreguntasClient.DeletePreguntaAsync(preguntaId);
      await CargarPreguntas(); // Recargar las preguntas después de eliminar una
    }
  }
  // Modifica los métodos para agregar y eliminar opciones
  private async Task EliminarOpcion(Preguntas pregunta, OpcionesCuestionario opcion)
  {
      if (opcion != null)
      {
          // Eliminar la opción
          await OpcionesClient.DeleteOpcionAsync(opcion.OpcionID);
          await CargarOpciones(pregunta); // Recargar las opciones después de eliminar una
          // Marcar la pregunta como modificada
          MarcarPreguntaComoModificada(pregunta);
      }
  }

  private async Task AgregarOpcion(Preguntas pregunta)
  {
      if (pregunta != null)
      {
          // Crear la nueva opción
          var opcion = new OpcionesCuestionario
          {
              Opcion = NuevaOpcion,
              PreguntaID = pregunta.PreguntaID
          };

          // Verificar si la nueva opción es igual a alguna de las opciones originales
          if (!pregunta.OpcionesOriginales.Contains(NuevaOpcion))
          {
              await OpcionesClient.CreateOpcionAsync(opcion);
              await CargarOpciones(pregunta); // Recargar las opciones después de agregar una nueva
              NuevaOpcion = ""; // Limpiar el campo de entrada
          }
      }
  }
  private async Task CargarOpciones(Preguntas pregunta)
  {
    if (pregunta != null)
    {
      pregunta.Opciones = (await OpcionesClient.GetOpcionesAsync(pregunta.PreguntaID)).ToList();
    }
  }
  private async Task CargarOpcionesParaTodasLasPreguntas()
  {
    if (Preguntas != null)
    {
      foreach (var pregunta in Preguntas)
      {
        await CargarOpciones(pregunta);
      }
    }
  }

  private void CambiarTextoPregunta(Preguntas pregunta)
  {
      CambiosRealizados = true;
  }

  private void CambiarTextoOpcion(Preguntas pregunta, OpcionesCuestionario opcion)
  {
      // Verificar si el texto de la opción ha cambiado desde su valor original
      if (opcion != null && !pregunta.OpcionesOriginales.Contains(opcion.Opcion ?? ""))
      {
          MarcarPreguntaComoModificada(pregunta);
      }
          Console.WriteLine("Opción modificada: " + opcion?.Opcion);
  }

  // Método auxiliar para marcar la pregunta como modificada
  private void MarcarPreguntaComoModificada(Preguntas pregunta)
  {
      CambiosRealizados = true;
  }
}
