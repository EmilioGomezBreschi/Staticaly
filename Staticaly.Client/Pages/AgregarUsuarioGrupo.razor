@page "/AgregarUsuario/{id}/{grupo}"
@using Models
@using Data
@using Microsoft.JSInterop
@inject NavigationManager NavigationManager
@inject UsuariosClient UsuariosClient
@inject EquiposClient EquiposClient
@inject EmailServiceClient EmailServiceClient
@inject IJSRuntime JSRuntime


<PageTitle>Agregar Usuario - Staticaly</PageTitle>

<div class="bg-Primary-Background text-white flex flex-col justify-center md:justify-normal items-center">
  @if (isLoading)
  {
    <div class="h-full absolute inset-0 flex justify-center items-center bg-black bg-opacity-50 z-50">
      <svg class="animate-spin h-8 w-8 text-primary-500" xmlns="http://www.w3.org/2000/svg" fill="none"
        viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647zM20 12a8 8 0 01-8 8v4c6.627 0 12-5.373 12-12h-4zm-2-5.291A7.962 7.962 0 0120 12h4c0-3.042-1.135-5.824-3-7.938l-3 2.647z">
        </path>
      </svg>
    </div>
  }
  @if (Aceptado)
  {
    <div class="h-screen absolute inset-0 flex justify-center items-center bg-black bg-opacity-50 z-20">
      <div class="flex flex-col items-center bg-green-600 text-primary-50 p-6 rounded-lg">
        <img src="Gifs/Success.gif" alt="Invitacion Enviada" class="w-40 h-40 mb-4" />
        <h2 class="text-xl font-bold">Invitacion enviada</h2>
      </div>
    </div>
  }
  <div class="w-full max-w-[610px] px-6 md:flex md:flex-col md:justify-evenly md:items-center">
    <div id="logo" class="text-center md:mt-8 mb-4">
      <img src="images/heart.svg" class="w-24 h-24 mx-auto" alt="Logo de Statica.ly" />
      <h1 class="text-3xl text-logo-text">Statica.ly</h1>
    </div>
    <div class="bg-primary-300 rounded-lg p-8">
      @if (ErrorMessage != "")
      {
        <div class="bg-red-500 text-white p-4 rounded-md text-center">
          <p>@ErrorMessage</p>
        </div>
      }
      <EditForm Model="@user" OnValidSubmit="Buscar" class="flex flex-col space-y-4 text-primary-400">
        <div class="relative my-3 bg-primary-100 rounded-md font-bold">
          <InputText @bind-Value="@user.Email" id="email" type="email" name="email"
            class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-12 placeholder-primary-400 bg-transparent"
            placeholder="Email del Usuario a Invitar" />
          <img src="images/email.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"
            alt="Icono de Correo" />
        </div>
        <button type="submit"
          class="w-full h-12 my-3 bg-primary-500 rounded-md text-primary-100 hover:bg-primary-700 transition duration-300">Buscar
          Correo</button>
        <button
          class="w-full h-12 my-3 ml-1 bg-orange-700 hover:bg-orange-800 rounded-md text-white transition duration-300"
          @onclick="NavegarAGrupos">Regresar</button>
      </EditForm>
      @if (buscado)
      {
        <div class="flex flex-col space-y-4 text-primary-500 mt-4">
          <h2 class="text-xl font-bold">Usuario Encontrado</h2>
          @if (usuarioinvitado != null)
          {
            <div class="flex flex-col space-y-4 text-primary-800 justify-start">
              <div class="flex flex-row">
                <p class="font-semibold mr-1">Nombre:</p>
                <p>@usuarioinvitado.Nombre</p>
              </div>
              <div class="flex flex-row">
                <p class="font-semibold mr-1">Apellido:</p>
                <p>@usuarioinvitado.Apellido</p>
              </div>
              <div class="flex flex-row">
                <p class="font-semibold mr-1">Rango:</p>
                <p>@usuarioinvitado.Rango?.NombreRango</p>
              </div>
            </div>
          }
        </div>
        <div class="flex flex-row my-3">
          <button
            class="w-full h-12 my-3 mr-1 bg-gray-700 hover:bg-gray-800 rounded-md text-white transition duration-300"
            @onclick="() => Invitar()">Enviar Invitacion</button>
        </div>
      }
    </div>
  </div>
</div>

@code {
  [Parameter] public string? id { get; set; }
  [Parameter] public string? grupo { get; set; }
  private User user = new User();
  private User? usuarioinvitador;
  private User? usuarioinvitado;
  private string ErrorMessage = "";
  private string body = "";
  private bool buscado = false;
  private bool isLoading = false;
  private bool Aceptado = false;

  protected override async Task OnInitializedAsync()
  {
    if (!int.TryParse(id, out int usuarioId))
      return;

    usuarioinvitador = await UsuariosClient.GetUsuarioAsync(usuarioId);
  }

  protected async Task Buscar()
  {
    if (string.IsNullOrWhiteSpace(user.Email))
    {
      ErrorMessage = "Favor de ingresar un correo válido";
      return;
    }

    isLoading = true;
    usuarioinvitado = await UsuariosClient.GetUsuarioByEmailAsync(user.Email);
    buscado = usuarioinvitado != null;
    ErrorMessage = buscado ? "" : "No se encontró el usuario";
    isLoading = false;
  }

  private async Task Invitar()
  {
    if (usuarioinvitado == null || string.IsNullOrWhiteSpace(usuarioinvitado.Email))
    {
      ErrorMessage = "No se encontró el usuario";
      return;
    }

    if (!int.TryParse(grupo, out int equipoId))
    {
      ErrorMessage = "ID de equipo no válido";
      return;
    }

    isLoading = true;
    var equipo = await EquiposClient.GetEquipoByIdAsync(equipoId);
    if (equipo == null)
    {
      ErrorMessage = "ID de equipo no válido";
      isLoading = false;
      return;
    }

    if (usuarioinvitador == null)
    {
      ErrorMessage = "No se encontró el usuario";
      isLoading = false;
      return;
    }

    var equipoUsuario = await EquiposClient.GetEquiposFromUsuarioAsync(usuarioinvitado.UsuarioID);
    if (equipoUsuario.Any(e => e.Equipo != null && e.Equipo.TipoEquipoID == usuarioinvitador.RolID))
    {
      ErrorMessage = "El usuario ya pertenece a un equipo de este tipo";
      isLoading = false;
      return;
    }

    body = EmailServiceClient.HacerBodyInvitacionEquipo(usuarioinvitado.Nombre, usuarioinvitado.Apellido,
    usuarioinvitador.Nombre, usuarioinvitador.Apellido, equipo.Nombre, equipo.EquipoID, usuarioinvitado.UsuarioID);
    if (body == null)
    {
      ErrorMessage = "Error al enviar la invitación";
      isLoading = false;
      return;
    }

    var email = new EmailDTO
      {
        Para = usuarioinvitado.Email,
        Asunto = "Invitación a Grupo",
        Contenido = body
      };

    await EmailServiceClient.SendEmailAsync(email);

    NavigationManager.Refresh();
  }

  private void NavegarAGrupos()
  {
    NavigationManager.NavigateTo($"/{id}/{grupo}");
  }
}
