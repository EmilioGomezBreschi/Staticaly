@page "/Cuestionario/{id}/{equipo}"
@page "/Cuestionario/{id}"
@page "/Cuestionario"
@using Models
@using Data
@using System.Net.Http
@inject NavigationManager NavigationManager
@inject CuestionarioClient CuestionarioClient

<PageTitle>Cuestionarios - Staticaly</PageTitle>

<div class="z-40 fixed top-0">
  <NavBar Id="@Id" Equipo="@Equipo" />
</div>

<div class="pt-11 pl-0 lg:pl-20 lg:pt-0 text-white flex flex-col justify-center md:justify-normal text-center items-center">
  @if (string.IsNullOrEmpty(Id))
  {
    <div class="h-screen absolute inset-0 flex justify-center items-center bg-black bg-opacity-50 z-20">
      <div class="flex flex-col items-center bg-red-600 p-6 rounded-lg">
        <img src="/images/prohibido.svg" alt="Acceso denegado" class="w-32 h-32" />
        <h2 class="text-xl font-bold">Para acceder a esta pagina debes estar registrado</h2>
        <button class="bg-white hover:bg-gray-300 transition duration-300 text-red-600 font-bold py-2 px-4 rounded-lg mt-4"
                @onclick='() => NavigationManager.NavigateTo("/registro")'>Registrarse</button>
      </div>
    </div>
  }
  else
  {
    <div class="h-full w-full flex flex-col justify-center text-primary-50">
      <div class="flex space-x-4 mt-4 justify-around text-primary-100">
        <button @onclick="async () => { await CargarCuestionariosGrupo(); SetBotonActivo(1); }"
                class="@((BotonActivo == 1) ? Activo : Inactivo)">
          Cuestionarios
        </button>
        <button @onclick="async () => { await CargarMisCuestionarios(); SetBotonActivo(2); }"
                class="@((BotonActivo == 2) ? Activo : Inactivo)">
          Mis Cuestionarios
        </button>
      </div>

      @if (CuestionariosDelGrupo.Count > 0)
      {
        <div class="flex flex-col h-full items-center mt-3">
          @foreach (var encuesta in CuestionariosDelGrupo)
          {
            <div class="bg-primary-500 rounded-lg p-4 w-96 m-auto flex flex-col items-center mt-6">
              <h2 class="text-2xl font-bold text-primary-800 mb-2">@encuesta.Titulo</h2>
              <p class="text-primary-700 mb-2">@encuesta.Descripcion</p>
              <p class="text-sm font-light">Por: @encuesta.Usuario?.Nombre @encuesta.Usuario?.Apellido</p>
              @if (encuesta.UsuarioID == Convert.ToInt32(Id))
              {
                <div class="flex flex-row w-full justify-between">
                  @if (encuesta.Publicado == false)
                  {
                  <button @onclick='() => NavigationManager.NavigateTo($"/editar-Cuestionario/{encuesta.CuestionarioID}")'
                          class="bg-yellow-600 hover:bg-yellow-700 text-white w-24 font-bold py-2 px-4 rounded-lg mt-4 transition duration-300">
                    Editar
                  </button>
                    <button @onclick='() => PublicarCuestionario(encuesta.CuestionarioID)'
                            class="bg-green-500 hover:bg-green-600 text-white w-24 font-bold py-2 px-4 rounded-lg mt-4 transition duration-300">
                      Publicar
                    </button>
                  }
                  <button @onclick='() => EliminarCuestionario(encuesta.CuestionarioID)'
                          class="bg-red-500 hover:bg-red-600 text-white w-24 font-bold py-2 px-4 rounded-lg mt-4 transition duration-300">
                    Eliminar
                  </button>
                </div>
              }
              else
              {
                <button @onclick='() => NavigationManager.NavigateTo($"/responder-Cuestionario/{encuesta.CuestionarioID}/{Id}")'
                        class="bg-primary-700 hover:bg-primary-800 text-white font-bold py-2 px-4 rounded-lg mt-4 transition duration-300">
                  Responder
                </button>
              }
            </div>
          }
        </div>
      }
      <div class="fixed bottom-0 right-0 mr-4 mb-4">
        <button @onclick='() => NavigationManager.NavigateTo($"/crear-Cuestionario/{Id}/{EquipoId}")'
                class="bg-primary-500 inline-flex items-center justify-center hover:bg-primary-700 text-white font-bold py-2 px-2 rounded-full md:rounded-md transition duration-300 text-center">
          <img src="Images/plus.svg" alt="Crear Publicación" class="h-6 w-6 inline-block" />
          <span class="ml-2 md:inline hidden">Crear Encuesta</span>
        </button>
      </div>
    </div>
  }
</div>

@code {
  [Parameter] public string? Id { get; set; }
  [Parameter] public string? Equipo { get; set; }
  public int EquipoId;
  public List<Cuestionarios> CuestionariosDelGrupo = new List<Cuestionarios>();
  public int BotonActivo = 1; // Variable para almacenar el estado del botón activo

  // Clases de estilo para los botones activos e inactivos
  public string Activo = " border-b-2 border-primary-500 hover:text-primary-300 transition duration-300 font-bold py-2 px-4 w-48";
  public string Inactivo = " border-b-2 border-transparent hover:text-primary-300 transition duration-300 font-bold py-2 px-4 w-48";

  protected override async Task OnInitializedAsync()
  {
    if (!string.IsNullOrEmpty(Id))
    {
      if (string.IsNullOrEmpty(Equipo))
      {
        EquipoId = 1;
      }
      else
      {
        EquipoId = int.Parse(Equipo);
      }
      await CargarCuestionariosGrupo();
    }
  }

  // Método para cargar las Cuestionarios de grupo
  private async Task CargarCuestionariosGrupo()
  {
    // Lógica para cargar las Cuestionarios de grupo
    var cuestionarios = await CuestionarioClient.ObtenerCuestionarioPorEquipoAsync(EquipoId);
    CuestionariosDelGrupo = cuestionarios.Where(c => c.UsuarioID != Convert.ToInt32(Id) && c.Publicado == true).ToList();
  }

  // Método para cargar mis Cuestionarios
  private async Task CargarMisCuestionarios()
  {
    // Lógica para cargar mis Cuestionarios
    var cuestionarios = await CuestionarioClient.ObtenerCuestionarioPorUsuarioAsync(Convert.ToInt32(Id));
    CuestionariosDelGrupo = cuestionarios.ToList();
  }

  // Método para establecer el botón activo
  private void SetBotonActivo(int boton)
  {
    BotonActivo = boton;
  }

  // Método para eliminar una Cuestionario
  private async Task EliminarCuestionario(int id)
  {
    var result = await CuestionarioClient.EliminarCuestionarioAsync(id);
    if (result != null)
    {
      await CargarMisCuestionarios();
    }
  }

  // Método para publicar una Cuestionario
  private async Task PublicarCuestionario(int id)
  {
    var result = await CuestionarioClient.ActualizarEstadoCuestionarioAsync(id,"true");
    if (result != null)
    {
      await CargarMisCuestionarios();
    }
  }
}
