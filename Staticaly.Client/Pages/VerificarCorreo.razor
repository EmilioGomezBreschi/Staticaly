@page "/verificar"
@using Models
@using Data
@inject NavigationManager NavigationManager
@inject UsuariosClient client

<PageTitle>Verificar Correo - Staticaly</PageTitle>

<div
  class="h-screen w-screen bg-Primary-Background text-white flex flex-col justify-center md:justify-normal items-center">
  <div class="w-full max-w-[610px] px-6 md:flex md:flex-col md:justify-evenly md:items-center">
    <div id="logo" class="text-center md:mt-8 mb-4">
      <img src="images/heart.svg" class="w-24 h-24 mx-auto" alt="Logo de Statica.ly" />
      <h1 class="text-3xl text-logo-text">Statica.ly</h1>
    </div>
    <div class="bg-primary-300 rounded-lg p-8">
      @if (ShowtokenInvalido)
      {
        <div class="bg-red-500 text-white p-4 rounded-md mb-4">
          <p class="text-center">El token ingresado es inválido</p>
        </div>
      }
      <EditForm Model="@user" OnValidSubmit="Verificar" class="flex flex-col space-y-4 text-primary-400">
        <div class="relative my-3 bg-primary-100 rounded-md font-bold">
          <InputText @bind-Value="@user.VerificationToken" id="token" type="text" name="token"
            class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-12 placeholder-primary-400 bg-transparent"
            placeholder="Token" />
          <ValidationMessage For="@(() => user.VerificationToken)" class="text-red-500" />
          <img src="images/llave.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"
            alt="Icono de llave" />
        </div>
        <button type="submit"
          class="w-full h-12 my-3 bg-primary-500 rounded-md text-primary-100 hover:bg-primary-700">Confirmar
          Correo</button>
      </EditForm>
    </div>
  </div>
</div>

@code {
  private User user = new User();
  private bool ShowtokenInvalido = false;

  private async Task Verificar()
  {
    try
    {
      // Verificar si el token es válido antes de intentar la verificación
      var isValidToken = await client.VerifyTokenAsync(user.VerificationToken);
      if (isValidToken)
      {
        await client.VerifyEmailAsync(user.VerificationToken);
        NavigationManager.NavigateTo("/login");
      }
      else
      {
        // Mostrar el mensaje de error si el token no es válido
        ShowtokenInvalido = true;
      }
    }
    catch (Exception ex)
    {
      ShowtokenInvalido = true;
      Console.WriteLine($"Error al verificar correo: {ex.Message}");
    }
  }
}
