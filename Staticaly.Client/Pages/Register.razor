@page "/registro"
@using Models;
@using Data;
@inject UsuariosClient client
@using SixLabors.ImageSharp
@using System.IO;
@using System.Diagnostics;
@using SixLabors.ImageSharp.Processing;
@inject EmailServiceClient emailServiceClient
@inject NavigationManager NavigationManager



<PageTitle>Registro - Staticaly</PageTitle>
<div class="h-screen bg-Primary-Background text-white font-Montserrat flex flex-col justify-center md:justify-normal items-center">
  @if (isLoading)
    {
        <div class="h-full absolute inset-0 flex justify-center items-center bg-black bg-opacity-50 z-50">
            <svg class="animate-spin h-8 w-8 text-primary-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647zM20 12a8 8 0 01-8 8v4c6.627 0 12-5.373 12-12h-4zm-2-5.291A7.962 7.962 0 0120 12h4c0-3.042-1.135-5.824-3-7.938l-3 2.647z"></path>
            </svg>
        </div>
    }
    <div class="flex flex-col max-w-[610px] justify-center md:justify-normal items-center">
        <div id="logo" class="text-center md:mt-8 mb-4">
            <img src="images/heart.svg" class="w-24 h-24 mx-auto" alt="Logo de Statica.ly" />
            <h1 class="text-3xl font-Montserrat text-logo-text">Statica.ly</h1>
        </div>
        <div class="bg-primary-300 rounded-lg p-8 flex flex-col items-center">
            @if (showEmailExistsError)
            {
                <div class="bg-red-500 font-bold text-white px-4 py-2 rounded-md mb-4">
                    El correo electrónico ya está registrado.
                </div>
            }
            <EditForm Model="@user" OnValidSubmit="RegistrarUsuario" class="flex flex-col text-primary-400">
                <div class="relative my-3 bg-primary-100 rounded-md font-bold">
                    <InputText @bind-Value="@user.Nombre" id="nombre"
                              class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-4 placeholder-primary-400 bg-transparent"
                              placeholder="Nombre" />
                    <ValidationMessage For="@(() => user.Nombre)" class="text-red-500" />
                    <img src="images/usuario.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"
                        alt="Icono de Usuario" />
                </div>
                <div class="relative my-3 bg-primary-100 rounded-md font-bold">
                    <InputText @bind-Value="@user.Apellido" id="apellido"
                              class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-4 placeholder-primary-400 bg-transparent"
                              placeholder="Apellido" />
                    <ValidationMessage For="@(() => user.Apellido)" class="text-red-500" />
                    <img src="images/usuario.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"
                        alt="Icono de Usuario" />
                </div>
                <div class="relative my-3 bg-primary-100 rounded-md font-bold">
                    <InputText @bind-Value="@user.Email" type="email" id="email"
                              class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-4 placeholder-primary-400 bg-transparent"
                              placeholder="Email" />
                    <ValidationMessage For="@(() => user.Email)" class="text-red-500" />
                    <img src="images/email.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"
                        alt="Icono de Usuario" />
                </div>
                <div class="relative mt-3 bg-primary-100 rounded-md font-bold">
                    <div class="relative">
                        <InputText @bind-Value="@user.Password" type="@GetPasswordType()" id="password"
                                  class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-12 placeholder-primary-400 bg-transparent"
                                  placeholder="Contraseña" />
                        <ValidationMessage For="@(() => user.Password)" class="text-red-500" />
                        <img src="images/llave.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"
                            alt="Icono de llave" />
                        <img src="images/ojo-abierto.svg" @onclick="TogglePasswordVisibility"
                            class="absolute right-3 top-1/2 transform -translate-y-1/2 w-6 h-6 cursor-pointer @(showPassword ? "visible" : "hidden")"
                            alt="Icono de ojo abierto" id="eyeOpen" />
                        <img src="images/ojo-cerrado.svg" @onclick="TogglePasswordVisibility"
                            class="absolute right-3 top-1/2 transform -translate-y-1/2 w-6 h-6 cursor-pointer @(showPassword ? "hidden" : "visible")"
                            alt="Icono de ojo cerrado" id="eyeClosed" />
                    </div>
                </div>
                @if (submitted && !ValidatePassword(user.Password))
                {
                    <div class="px-5 py-2 bg-red-500 rounded-md font-bold text-xs text-white text-left max-w-full">
                        <p class="mb-1">La contraseña debe contener al menos:</p>
                        <ul class="list-disc">
                          <li>Una mayúscula</li>
                          <li>Una minúscula</li>
                          <li>Un número</li>
                          <li>Seis caracteres como mínimo</li>
                        </ul>
                    </div>
                }
                <div class="flex items-center mt-6 text-primary-50">
                    <label for="esDocente" class="mr-2 font-bold">¿Eres Docente?</label>
                    <input type="checkbox" id="esDocente" @bind="@esDocente" class="form-checkbox h-5 w-5 text-primary-600" />
                </div>
                @if (esDocente == true)
                {
                    <div class="relative my-3 bg-primary-100 rounded-md font-bold">
                      <div class="relative">
                        <InputText @bind-Value="@InstitucionDocente" id="InstitucionDocente"
                                  class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-4 placeholder-primary-400 bg-transparent"
                                  placeholder="Institucion de Docente" />
                                  <img src="images/school.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"/>
                      </div>
                    </div>
                    <div class="relative my-3 bg-primary-100 rounded-md font-bold">
                      <div class="relative">
                        <InputSelect TValue="int" @bind-Value="@Semestre"
                                    class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-4 placeholder-primary-400 bg-transparent">
                            <option value="0" selected>Selecciona un semestre</option>
                            @for (int i = 1; i <= 8; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </InputSelect>
                        <img src="images/semestre.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"/>
                      </div>
                    </div>
                    <div class="relative my-3 bg-primary-100 rounded-md font-bold flex items-center justify-center text-center">
                        <label for="fotoDocente" class="absolute left-3">
                            <img src="images/camera.svg" alt="Icono de cámara" class="h-6 w-6" />
                        </label>
                        <InputFile id="fotoDocente" class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-4 placeholder-primary-400 bg-transparent" accept=".jpg,.jpeg,.png" OnChange="HandleFileSelected" />
                    </div>
                    @if (FotoDocente != null)
                    {
                        <div class="flex justify-center items-center">
                          <img src="data:image;base64,@(Convert.ToBase64String(FotoDocente))" alt="Foto seleccionada" class="my-3 max-w-24 max-h-24 hover:max-w-[430px] hover:max-h-[430px]" />
                        </div>
                    }
                    @if (submitted && ValidateFoto == false)
                    {
                      <div class="px-5 py-2 bg-red-500 rounded-md font-bold text-xs text-white text-left max-w-full">
                        <p class="mb-1">La Imagen debe ser:</p>
                        <ul class="list-decimal">
                          <li>Archivo ".jpg .png .jpeg"</li>
                          <li>Archivo menor a 480x480px</li>
                        </ul>
                      </div>
                    }
                }
                <button type="submit" class="w-full h-12 my-3 bg-primary-500 rounded-md text-primary-100">Registrarse</button>
            </EditForm>
            <a href="/login" class="text-sm text-primary-700 text-center mt-4 block mx-auto font-bold">¿Ya tienes cuenta?</a>
        </div>
    </div>
</div>

@code {
    private User user = new User();
    private EmailDTO email = new EmailDTO();
    private string InstitucionDocente = "";
    private int Semestre = 0;
    private byte[]? FotoDocente;
    private bool showPassword = false;
    private bool submitted = false;
    private bool showEmailExistsError = false;
    private bool ValidateFoto = true;
    private bool esDocente = false;
    private bool isLoading = false;

  private async Task RegistrarUsuario()
  {
      string body = "";
      submitted = true;

      // Validar si hay campos requeridos vacíos
      if (string.IsNullOrWhiteSpace(user.Nombre) || string.IsNullOrWhiteSpace(user.Apellido) ||
          string.IsNullOrWhiteSpace(user.Email) || string.IsNullOrWhiteSpace(user.Password))
      {
          isLoading = false;
          return;
      }
      try
      {
          isLoading = true;
          await Task.Delay(2000);
      // Verificar si el correo electrónico ya existe
      var existingUser = await client.GetUsuarioByEmailAsync(user.Email);
      if (existingUser != null)
      {
          Console.WriteLine("El correo electrónico ya ha sido registrado.");
          showEmailExistsError = true;
          isLoading = false;
          return;
      }

      // Validar la contraseña
      if (!ValidatePassword(user.Password))
      {
          Console.WriteLine("La contraseña debe tener al menos una mayúscula, una minúscula, un número y seis caracteres como mínimo.");
          isLoading = false;
          return;
      }

      // Asignar el rol según si es docente o usuario normal
      if (esDocente == true)
      {
          if (Semestre == 0 || string.IsNullOrWhiteSpace(InstitucionDocente) || FotoDocente == null)
          {
              isLoading = false;
              // No hacer nada si hay campos requeridos vacíos
              return;
          }
          // Agregar la Imagen a la base de datos
          user.Imagen = FotoDocente;
          // Enviar correo al Admin para la aprobacion del docente
          body = emailServiceClient.HacerBodyDocente(user.Nombre, user.Apellido, InstitucionDocente, Semestre);
          await emailServiceClient.SendEmailAsync(new EmailDTO
          {
              Para = "staticaly.services@gmail.com",
              Asunto = "Nuevo Docente registrado",
              Contenido = body
          });
      }
      // Rol para usuario normal
      user.RolID = 2;
      user.RangoID = 1;

      // Crear el usuario
      await client.CreateUsuarioAsync(user);

      // Enviar correo electrónico de verificación
      body = emailServiceClient.HacerBodyVerificacion(user.Nombre, user.Apellido, user.VerificationToken);
      await emailServiceClient.SendEmailAsync(new EmailDTO
      {
          Para = user.Email,
          Asunto = "Verificación de correo electrónico",
          Contenido = body
      });

      // Redirigir al usuario a la página principal
      NavigationManager.NavigateTo("/login");
      isLoading = false;
      }
      catch (Exception ex)
      {
          isLoading = false;
          Console.WriteLine(ex.Message);
      }
  }

    private bool ValidatePassword(string? password)
    {
        // Validar la contraseña
        if (string.IsNullOrWhiteSpace(password) || password.Length < 6)
        {
            return false;
        }

        bool hasUpperCase = false;
        bool hasLowerCase = false;
        bool hasDigit = false;

        foreach (char c in password)
        {
            if (char.IsUpper(c))
            {
                hasUpperCase = true;
            }
            else if (char.IsLower(c))
            {
                hasLowerCase = true;
            }
            else if (char.IsDigit(c))
            {
                hasDigit = true;
            }
        }

        return hasUpperCase && hasLowerCase && hasDigit;
    }

    private void TogglePasswordVisibility()
    {
        // Alternar la visibilidad de la contraseña
        showPassword = !showPassword;
    }

    private string GetPasswordType()
    {
        // Obtener el tipo de entrada de la contraseña (texto o contraseña)
        return showPassword ? "text" : "password";
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        // Verificar la extensión del archivo
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (extension != ".jpg" && extension != ".jpeg" && extension != ".png")
        {
            ValidateFoto = false;
            // Mostrar un mensaje de error o manejar de otra forma
            Debug.WriteLine("El archivo debe ser una imagen JPG o PNG.");
            return;
        }

        // Leer el archivo en un buffer de bytes
        var buffer = new byte[file.Size];
        await file.OpenReadStream().ReadAsync(buffer);

        // Validar la resolución de la imagen (opcional)
        using (var imageStream = new MemoryStream(buffer))
        using (var image = Image.Load(imageStream))
        {
            if (image.Width > 480 || image.Height > 480)
            {
                // Mostrar un mensaje de error o manejar de otra forma
                ValidateFoto = false;
                Debug.WriteLine("La imagen debe tener una resolución máxima de 480p.");
                return;
            }
        }

        // Asignar el buffer de bytes a la propiedad FotoDocente
        FotoDocente = buffer;
    }

}
