@page "/olvidada"
@using Models;
@using Data;
@inject UsuariosClient client
@inject EmailServiceClient emailServiceClient
@inject NavigationManager NavigationManager



<PageTitle>Registro - Staticaly</PageTitle>

<div
  class="h-screen w-screen bg-Primary-Background text-white font-Montserrat flex flex-col justify-center md:justify-normal items-center">
  <div class="w-full max-w-[610px] px-6 md:flex md:flex-col md:justify-evenly md:items-center">
    <div id="logo" class="text-center md:mt-8 mb-4">
      <img src="images/heart.svg" class="w-24 h-24 mx-auto" alt="Logo de Statica.ly" />
      <h1 class="text-3xl font-Montserrat text-logo-text">Statica.ly</h1>
    </div>
    <div class="bg-primary-300 rounded-lg p-8">
      <EditForm Model="@user" OnValidSubmit="MandarRecuperacion" class="flex flex-col text-primary-400">
        <div class="relative my-3 bg-primary-100 rounded-md font-bold">
          <InputText @bind-Value="@user.Email" type="email" id="email"
            class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-4 placeholder-primary-400 bg-transparent"
            placeholder="Email" />
          <ValidationMessage For="@(() => user.Email)" class="text-red-500" />
          <img src="images/email.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"
            alt="Icono de Correo" />
        </div>
        <button type="submit" class="w-full h-12 my-3 bg-primary-500 rounded-md text-primary-100">Mandar</button>
      </EditForm>
      <a href="/login" class="text-sm text-primary-700 text-center mt-4 block mx-auto font-bold">¿Ya tienes cuenta?</a>
    </div>
  </div>
</div>

@code {
  private User user = new User();

  private async Task MandarRecuperacion()
  {
    var existinguser = await client.GetUsuarioByEmailAsync(user.Email);
    if (existinguser != null)
    {
      if (user != null && !string.IsNullOrEmpty(user.Email))
      {
        await emailServiceClient.SendEmailAsync(new EmailDTO
          {
            Para = user.Email,
            Asunto = "Cambio de contraseña",
            Contenido =
          $@"<!DOCTYPE html>
<html lang='en'>
<head>
<meta charset='UTF-8'>
<meta name='viewport' content='width=device-width, initial-scale=1.0'>
<title>Cambio de contraseña - Staticaly</title>
<style>
body {{
font-family: Montserrat, sans-serif;
background-color: #000a23;
margin: 0;
padding: 0;
display: flex;
justify-content: center;
align-items: center;
height: 100vh;
}}
.container {{
max-width: 600px;
background-color: #557996;
border-radius: 10px;
padding: 20px;
box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
text-align: center;
}}
h1 {{
color: #02253d;
margin-bottom: 20px;
}}
p {{
color: #d2e3f1;
margin-bottom: 10px;
}}
a {{
color: #007bff;
text-decoration: none;
}}
a:hover {{
text-decoration: underline;
}}
.logo {{
width: 100px;
height: auto;
margin-bottom: 20px;
}}
</style>
</head>
<body>
<div class='container'>
<img src='./wwwroot/images/heart.svg' alt='Statica.ly Logo' class='logo'>
<h1>¡Hola {existinguser.Nombre} {existinguser.Apellido}!</h1>
<p>Escuchamos que olvidaste tu contraseña en Statica.ly. Por favor, haz clic en el siguiente enlace para cambiar tu
contraseña:</p>
<p><a href='http://localhost:5197/cambiarcontrasena/{existinguser.UsuarioID}'>Aqui</a></p>
</div>
</body>
</html>"
          });
      }
      else
      {
        Console.WriteLine("No se puede enviar el correo electrónico porque el usuario o el correo electrónico es nulo.");
        return;
      }
      NavigationManager.NavigateTo("/login");
    }
  }
}