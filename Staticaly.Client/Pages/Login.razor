@page "/login"
@using Models;
@using Data;
@using BCrypt.Net;
@inject NavigationManager NavigationManager
@inject UsuariosClient client

<PageTitle>Login - Staticaly</PageTitle>

<div class="text-white flex flex-col justify-center md:justify-normal items-center">
  @if (isLoading)
  {
    <div class="h-full absolute inset-0 flex justify-center items-center bg-black bg-opacity-50 z-50">
      <svg class="animate-spin h-8 w-8 text-primary-500" xmlns="http://www.w3.org/2000/svg" fill="none"
        viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647zM20 12a8 8 0 01-8 8v4c6.627 0 12-5.373 12-12h-4zm-2-5.291A7.962 7.962 0 0120 12h4c0-3.042-1.135-5.824-3-7.938l-3 2.647z">
        </path>
      </svg>
    </div>
  }
  <div id="logo" class="text-center md:mt-8 mb-4">
    <img src="images/heart.svg" class="w-24 h-24 mx-auto" alt="Logo de Statica.ly" />
    <h1 class="text-3xl text-logo-text">Statica.ly</h1>
  </div>
  <div class="bg-primary-300 rounded-lg p-8">
    <EditForm Model="@user" OnValidSubmit="Ingreso" class="flex flex-col text-primary-400">
      @if (errorMessage != "")
      {
        <div class="relative mt-1 text-xs text-center bg-red-500 font-bold text-white px-4 py-2 rounded-md mb-4">
          @errorMessage
        </div>
      }
      <div class="relative my-3 bg-primary-100 rounded-md font-bold">
        <InputText @bind-Value="@user.Email" type="email" id="email"
          class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-4 placeholder-primary-400 bg-transparent"
          placeholder="Correo" />
        <ValidationMessage For="@(() => user.Email)" class="text-red-500" />
        <img src="images/email.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"
          alt="Icono de Correo" />
      </div>
      <div class="relative my-3 bg-primary-100 rounded-md font-bold">
        <InputText @bind-Value="@user.Password" type="@GetPasswordType()" id="password"
          class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-12 placeholder-primary-400 bg-transparent"
          placeholder="Contraseña" />
        <ValidationMessage For="@(() => user.Password)" class="text-red-500" />
        <img src="images/llave.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"
          alt="Icono de llave" />
        <img src="images/ojo-abierto.svg" @onclick="TogglePasswordVisibility"
          class="absolute right-3 top-1/2 transform -translate-y-1/2 w-6 h-6 cursor-pointer @(showPassword ? "visible" : "hidden")"
          alt="Icono de ojo abierto" id="eyeOpen" />
        <img src="images/ojo-cerrado.svg" @onclick="TogglePasswordVisibility"
          class="absolute right-3 top-1/2 transform -translate-y-1/2 w-6 h-6 cursor-pointer @(showPassword ? "hidden" : "visible")"
          alt="Icono de ojo cerrado" id="eyeClosed" />
      </div>
      <button type="submit"
        class="w-full h-12 my-3 bg-primary-500 rounded-md text-primary-100 hover:bg-primary-700">Iniciar
        Sesión</button>
    </EditForm>
    <a href="/olvidada" class="text-sm font-bold text-primary-700 text-center mt-4 block mx-auto">¿Has olvidado tu
      contraseña?</a>
    <hr class="w-11/12 border-t-2 border-Primary-Background my-4 mx-auto" />
    <div class="text-center mb-3">
      <button class="w-3/4 h-12 bg-primary-500 rounded-md text-primary-100 mx-auto hover:bg-primary-700"
        @onclick="NavigateToRegisterPage">Registrarse</button>
    </div>
  </div>
</div>

@code {
  private User user = new User();
  private bool showPassword = false;
  private bool isLoading = false;
  private string errorMessage = "";
  private string GetPasswordType() => showPassword ? "text" : "password";
  private void TogglePasswordVisibility() => showPassword = !showPassword;
  private void NavigateToRegisterPage() => NavigationManager.NavigateTo("/registro");
  private void SetErrorMessage(string message)
  {
    errorMessage = message;
  }

  private async Task Ingreso()
  {
    if (string.IsNullOrEmpty(user.Email) || string.IsNullOrEmpty(user.Password))
    {
      SetErrorMessage("Por favor, llena todos los campos.");
      isLoading = false;
      return;
    }
    isLoading = true;
    // Obtener el usuario por su correo electrónico
    var existingUser = await client.GetUsuarioByEmailAsync(user.Email);

    if (existingUser == null)
    {
      SetErrorMessage("Usuario no encontrado.");
      isLoading = false;
      return;
    }

    // Verificar si la contraseña coincide
    if (BCrypt.Verify(user.Password, existingUser.Password))
    {
      if (!existingUser.EmailVerified)
      {
        SetErrorMessage("El correo electrónico no ha sido verificado.");
        isLoading = false;
        return;
      }

      NavigationManager.NavigateTo($"/{existingUser.UsuarioID}");
    }
    else
    {
      SetErrorMessage("Usuario o contraseña incorrectos");
      isLoading = false;
    }
  }

}
