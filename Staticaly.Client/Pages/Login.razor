@page "/login"
@using Models;
@using Data;
@inject NavigationManager NavigationManager
@inject UsuariosClient client

<PageTitle>Login - Staticaly</PageTitle>

<div
  class="h-screen w-screen bg-Primary-Background text-white font-Montserrat flex flex-col justify-center md:justify-normal items-center">
  <div class="w-full max-w-[250px] px-6 md:flex md:flex-col md:justify-evenly md:items-center">
    <div id="logo" class="text-center md:mt-8 mb-4">
      <img src="images/heart.svg" class="w-24 h-24 mx-auto" alt="Logo de Statica.ly" />
      <h1 class="text-3xl font-Montserrat text-logo-text">Statica.ly</h1>
    </div>
    <div class="bg-primary-300 rounded-lg p-8">
      <EditForm Model="@user" OnValidSubmit="Ingreso" class="flex flex-col text-primary-400">
        @if (loginError)
        {
          <div
            class="relative mt-1 text-xs text-center bg-red-500 font-bold text-white px-4 py-2 rounded-md mb-4">
            Las credenciales son incorrectas.
          </div>
        }
        <div class="relative my-3 bg-primary-100 rounded-md font-bold">
          <InputText @bind-Value="@user.Email" type="email" id="email"
            class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-4 placeholder-primary-400 bg-transparent"
            placeholder="Usuario" />
          <ValidationMessage For="@(() => user.Email)" class="text-red-500" />
          <img src="images/usuario.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"
            alt="Icono de usuario" />
        </div>
        <div class="relative my-3 bg-primary-100 rounded-md font-bold">
          <InputText @bind-Value="@user.Password" type="@GetPasswordType()" id="password"
            class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-12 placeholder-primary-400 bg-transparent"
            placeholder="Contraseña" />
          <ValidationMessage For="@(() => user.Password)" class="text-red-500" />
          <img src="images/llave.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"
            alt="Icono de llave" />
          <img src="images/ojo-abierto.svg" @onclick="TogglePasswordVisibility"
            class="absolute right-3 top-1/2 transform -translate-y-1/2 w-6 h-6 cursor-pointer @(showPassword ? "visible" : "hidden")"
            alt="Icono de ojo abierto" id="eyeOpen" />
          <img src="images/ojo-cerrado.svg" @onclick="TogglePasswordVisibility"
            class="absolute right-3 top-1/2 transform -translate-y-1/2 w-6 h-6 cursor-pointer @(showPassword ? "hidden" : "visible")"
            alt="Icono de ojo cerrado" id="eyeClosed" />
        </div>
        <button type="submit" class="w-full h-12 my-3 bg-primary-500 rounded-md text-primary-100">Iniciar
          Sesión</button>
      </EditForm>
      <a href="/olvidada" class="text-sm font-bold text-primary-700 text-center mt-4 block mx-auto">¿Has olvidado tu
        contraseña?</a>
      <hr class="w-11/12 border-t-2 border-Primary-Background my-4 mx-auto">
      <div class="text-center mb-3">
        <button class="w-3/4 h-12 bg-primary-500 rounded-md text-primary-100 mx-auto"
          @onclick="NavigateToRegisterPage">Registrarse</button>
      </div>
    </div>
  </div>
</div>

@code {
  private User user = new User();
  private bool showPassword = false;
  private bool loginError = false;

  private string GetPasswordType() => showPassword ? "text" : "password";

  private void TogglePasswordVisibility() => showPassword = !showPassword;

  private void NavigateToRegisterPage() => NavigationManager.NavigateTo("/registro");

  private async Task Ingreso()
  {
    var users = await client.GetUsuariosAsync();
    if (users == null)
    {
      Console.WriteLine("La lista de usuarios es nula.");
      return;
    }

    var foundUser = users.FirstOrDefault(u => u.Email == user.Email && u.Password == user.Password && u.EmailVerified ==
    true);
    if (foundUser != null)
    {
      NavigationManager.NavigateTo("/");
    }
    else
    {
      loginError = true;
      NavigationManager.NavigateTo("/login");
      Console.WriteLine("Usuario o contraseña incorrectos");
    }
  }
}
