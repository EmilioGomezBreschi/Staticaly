@page "/EditarPermisos/{id}/{equipo}"
@using Staticaly.Client.Data
@using Staticaly.Client.Models
@inject NavigationManager NavigationManager
@inject EquiposClient equiposClient

<PageTitle>Editar Permisos - Staticaly</PageTitle>
<div class="z-40 fixed top-0 w-full">
  <NavBar Id="@Id" Equipo="@Equipo" />
</div>

<div
  class="h-screen w-screen pt-11 pl-0 lg:pl-20 lg:pt-0 text-white flex flex-col justify-center md:justify-normal text-center items-center">
  <div class="flex-1 h-screen flex flex-col justify-center items-center text-primary-50">
    @foreach (var usuario in Usuarios)
    {
      <div class="flex flex-row justify-between w-full px-4 py-2 bg-primary-300 mt-1 rounded-md">
          <div class="text-left mr-2">
            @(usuario.Usuario?.Nombre ?? "Unknown User") @(usuario.Usuario?.Apellido ?? "Unknown User")
            <div>@(usuario.Usuario?.Rango?.NombreRango ?? "Unknown Rango")</div>
        </div>
        <div class="flex items-center text-right ml-2">
          <label class="switch">
            <input type="checkbox" checked="@IsChecked(usuario.PermisoID)"
              @onclick="(async () => await TogglePermiso(usuario))" class="hidden" />
            <div class="flex flex-col toggle__dot w-24 h-6 px-4 items-center justify-center bg-primary-600 rounded-md shadow">
              <span
                class="text-xs text-primary-50 font-bold">@GetLabel(usuario.PermisoID)</span>
            </div>
          </label>
        </div>
      </div>
    }
  </div>
</div>


@code {
  [Parameter] public string? Id { get; set; }
  [Parameter] public string? Equipo { get; set; }
  int Equipoid;
  private List<UsuariosEquipos> Usuarios = new List<UsuariosEquipos>();

  protected override async Task OnInitializedAsync()
  {
    if (!string.IsNullOrEmpty(Equipo))
    {
      Equipoid = int.Parse(Equipo);
      var usuariosArray = await equiposClient.GetUsuariosFromEquipoAsync(Equipoid);
      Usuarios = usuariosArray.Where(u => u.PermisoID != 1).ToList();
    }
  }

  private bool IsChecked(int permisoID)
  {
    // El checkbox está marcado si el permiso es igual a 2
    return permisoID == 2;
  }

  private string GetLabel(int permisoID)
  {
    // Devuelve "Visualizar" si el permiso es igual a 2, y "Editar" si es igual a 3
    return permisoID == 2 ? "Visualizar" : "Editar";
  }

  private async Task TogglePermiso(UsuariosEquipos usuario)
  {
    // Cambiar el permiso a 3 si actualmente es 2, y viceversa
    int nuevoPermisoID = usuario.PermisoID == 2 ? 3 : 2;
    await equiposClient.UpdatePermisoUsuarioAsync(usuario.UsuarioEquipoID, nuevoPermisoID);
    var index = Usuarios.IndexOf(usuario);
    Usuarios[index].PermisoID = nuevoPermisoID;
  }
}