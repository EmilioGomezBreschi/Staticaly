@page "/Publicacion/{publicacion}/{id}"
@page "/Publicacion/{publicacion}"
@using Models
@using Data
@using Microsoft.JSInterop
@using System.Text.Json
@using System.IO
@using System.Text
@inject NavigationManager NavigationManager
@inject PublicacionesClient PublicacionClient
@inject ComentariosClient ComentariosClient
@inject CalificacionesClient CalificacionesClient
@inject ReportesClient ReportesClient
@inject IJSRuntime JSRuntime


<PageTitle>Publicación - Staticaly</PageTitle>

<div class="z-40 fixed top-0">
  <NavBar Id="@Id" Equipo="@Equipo" />
</div>

<div class="pt-16 pl-0 lg:pl-20 lg:pt-0 text-primary-100 flex flex-col justify-normal text-center items-center">
  <div id="logo" class="text-center md:mt-8 mb-4">
    <img src="images/heart.svg" class="w-24 h-24 mx-auto" alt="Logo de Statica.ly" />
    <h1 class="text-3xl text-logo-text">Statica.ly</h1>
  </div>
  <div class="bg-primary-300 rounded-lg p-8 text-primary-100 w-full max-w-[600px]">
    <div class="mt-2 rounded-md p-5 relative">
      @if (publicacionData.Reportada ?? false)
      {
        <img src="images/redflag.svg" class="absolute top-0 right-0 w-6 h-6 cursor-pointer" alt="Banderita"
          @onclick="() => EliminarReportePublicacion()" />
      }
      else
      {
        <img src="images/flag.svg" class="absolute top-0 right-0 w-6 h-6 cursor-pointer" alt="Banderita"
          @onclick="() => ReportarPublicacion(publicacionData.PublicacionID)" />
      }
    </div>
    @if (ErrorMessage != "")
    {
      <div class="bg-red-500 text-white p-4 rounded-md text-center">
        <p>@ErrorMessage</p>
      </div>
    }
    <h2 class="text-center font-bold text-2xl text-primary-600">@publicacionData.Titulo</h2>
    <div class="mt-1 px-3 flex flex-row justify-around mb-4">

      <div class="text-center flex flex-col mr-5">
        @if (publicacionData.Usuario != null && publicacionData.Usuario.Rango != null)
        {
          <p class="font-semibold text-primary-500">@publicacionData.Usuario.Nombre</p>
          <p class="font-light">@publicacionData.Usuario.Rango.NombreRango</p>
        }
        else
        {
          <p class="text-left">Anónimo</p>
        }
      </div>
      <div class="flex flex-col w-full max-w-[600px] md:w-96">
        <p class="text-justify w-full mr-5 mb-4 text-wrap break-words">@publicacionData.Contenido</p>
        @if (publicacionData.Imagen != null)
        {
          <img src="data:image;base64,@(Convert.ToBase64String(publicacionData.Imagen))" alt="Foto seleccionada"
            class="max-w-[430px] max-h-[430px]" />
        }
      </div>
    </div>
    @if (Id != null)
    {
      <button class="bg-primary-100 text-primary-500 hover:bg-primary-200 transition duration-300 rounded-md p-2 w-full"
        @onclick='() => NavigationManager.NavigateTo($"/Comentar/{publicacion}/{Id}")'>
        <p class="text-center">Comentar</p>
      </button>
    }
    @foreach (var comentario in comentariosData)
    {
      <div class="mt-2 bg-primary-500 rounded-md p-5">
        <div class="mt-2 bg-primary-500 rounded-md p-5 relative">
          @if (comentario.Reportado ?? false)
          {
            <img src="images/redflag.svg" class="absolute top-0 right-0 w-6 h-6 cursor-pointer" alt="Banderita"
              @onclick="() => EliminarReporteComentario(comentario.ComentarioID)" />
          }
          else
          {
            <img src="images/flag.svg" class="absolute top-0 right-0 w-6 h-6 cursor-pointer" alt="Banderita"
              @onclick="() => ReportarComentario(comentario.ComentarioID)" />
          }
        </div>
        <div class="flex flex-row">
          <div class="mr-2">
            @if (comentario.Usuario != null && comentario.Usuario.Rango != null)
            {
              <p class="font-semibold text-primary-900 text-left">@comentario.Usuario.Nombre</p>
              <p class="font-light text-left">@comentario.Usuario.Rango.NombreRango</p>
            }
            else
            {
              <p class="text-left font-semibold text-primary-900">Anónimo</p>
            }
          </div>
          <div class="flex flex-col w-full max-w-[550px] md:w-96 ml-2">
            <p class="text-justify text-wrap break-words">@comentario.Contenido</p>
            @if (comentario.Imagen != null)
            {
              <img src="data:image;base64,@(Convert.ToBase64String(comentario.Imagen))" alt="Foto seleccionada"
                class="max-w-[430px] max-h-[430px]" />
            }
          </div>
        </div>
        <div class="flex items-center">
          @if (comentario.Calificacion != null)
          {
            <div class="mr-2">
              @for (int i = 1; i <= 5; i++)
              {
                <span class="text-yellow-500 inline-block">@((i <= comentario.Calificacion) ? "★" : "☆")</span>
              }
            </div>
          }
          @if (Id != null)
          {
            <div class="cursor-pointer">
              @for (int i = 1; i <= 5; i++)
              {
                <span class="text-yellow-500 inline-block"
                  @onclick='() => CalificarComentario(comentario.ComentarioID, i, Id)'
                  @onmouseover='()=>MostrarEstrellas(comentario.ComentarioID, i)'
                  @onmouseleave='()=>RestaurarEstrellas(comentario.ComentarioID)'>
                  @{
                    var currentRating = hoverRatings.ContainsKey(comentario.ComentarioID) ?
                    hoverRatings[comentario.ComentarioID] : calificacion;
                    var isStarFilled = i <= currentRating;
                  }
                  @if (isStarFilled)
                  {
                    <span>★</span>
                  }
                  else
                  {
                    <span>☆</span>
                  }
                </span>
              }
            </div>
          }
        </div>
        <p class="text-justify ml-2">@comentario.Fecha?.ToString("dd/MM/yyyy")</p>
        @if (comentario.UsuarioID == (int.Parse(Id ?? "0")))
        {
          <div class="flex flex-row justify-end">
            <button class="bg-red-500 text-white hover:bg-red-600 transition duration-300 rounded-md p-2"
              @onclick='() => EliminarComentario(comentario.ComentarioID)'>
              <p class="text-center">Eliminar</p>
            </button>
          </div>
        }
      </div>
    }
    <p class="text-left mt-2">@publicacionData.Fecha.ToString("dd/MM/yyyy")</p>
  </div>
</div>

@code {
  private string ErrorMessage = "";

  [Parameter]
  public string? publicacion { get; set; }
  [Parameter]
  public string? Id { get; set; }
  public string? Equipo { get; set; }
  private int calificacion = 0;
  private Dictionary<int, int?> hoverRatings = new Dictionary<int, int?>();
  public Publicaciones publicacionData { get; set; } = new Publicaciones();
  public List<Comentarios> comentariosData { get; set; } = new List<Comentarios>();
  public float? hoverRating;

  protected override async Task OnInitializedAsync()
  {
    if (publicacion == null)
    {
      NavigationManager.NavigateTo("/");
    }
    else
    {
      await ObtenerPublicacion();
      if (publicacionData == null)
      {
        NavigationManager.NavigateTo("/");
      }
      else
      {
        Equipo = publicacionData.ForoID.ToString();
        await ObtenerComentarios();
      }
    }
  }

  private async Task EliminarComentario(int id)
  {
    var response = await ComentariosClient.DeleteComentarioAsync(id);
    if (response != null)
    {
      ErrorMessage = "";
      await ObtenerComentarios();
    }
    else
    {
      ErrorMessage = "No se pudo eliminar el comentario";
    }
  }

  private async Task ObtenerComentarios()
  {
    var response = await ComentariosClient.GetComentariosAsync(int.Parse(publicacion ?? "0"));

    if (response != null)
    {
      var comentariosFiltrados = new List<Comentarios>();
      comentariosData = response.ToList();

      foreach (var comentario in comentariosData)
      {
        var reportesComentarios = await ReportesClient.GetReportesByComentarioAsync(comentario.ComentarioID);
        if (reportesComentarios != null)
        {
          comentario.Reportado = reportesComentarios.Any(r => r.UsuarioID == int.Parse(Id ?? "0"));
          // Contar el número de reportes para este comentario
          var numReportes = reportesComentarios.Count();
          // Verificar si el número de reportes es menor que 3
          if (numReportes < 3)
          {
            // Si hay menos de 3 reportes, agregar el comentario a la lista filtrada
            comentariosFiltrados.Add(comentario);
          }
        }
      }

      // Asignar la lista filtrada a comentariosData
      comentariosData = comentariosFiltrados;
    }
  }
  private async Task ObtenerPublicacion()
  {
    var response = await PublicacionClient.GetPublicacionAsync(int.Parse(publicacion ?? "0"));

    if (response != null)
    {
      publicacionData = response;

      // Obtener todos los reportes relacionados con la publicación
      var reportesPublicacion = await ReportesClient.GetReportesByPublicacionAsync(publicacionData.PublicacionID);
      if (reportesPublicacion != null)
      {
        // Verificar si alguno de los reportes pertenece al usuario actual
        publicacionData.Reportada = reportesPublicacion.Any(r => r.UsuarioID == int.Parse(Id ?? "0"));
      }
    }
  }

  private async Task CalificarComentario(int ComentarioID, int calificacion, string id)
  {
    // Convertir calificacion a float antes de asignarlo
    float calificacionFloat = calificacion;

    Console.WriteLine(calificacionFloat);
    Console.WriteLine(ComentarioID);
    Console.WriteLine(id);

    await CalificacionesClient.CrearOActualizarCalificacionAsync(ComentarioID, int.Parse(id), calificacionFloat);
    await ObtenerComentarios();
  }

  private void MostrarEstrellas(int ComentarioID, int calificacion)
  {
    hoverRatings[ComentarioID] = calificacion;
  }

  private void RestaurarEstrellas(int ComentarioID)
  {
    hoverRatings.Remove(ComentarioID);
  }

  private async Task ReportarPublicacion(int publicacionID)
  {
    Reportes nuevoReporte = new Reportes
      {
        UsuarioID = int.Parse(Id ?? "0"), // Suponiendo que Id es el ID del usuario actual
        PublicacionID = publicacionID
      };

    var response = await ReportesClient.CreateReporteAsync(nuevoReporte);

    if (response.IsSuccessStatusCode)
    {
      // Actualizar el estado de la publicación para mostrar la banderita roja
      publicacionData.Reportada = true;
    }
    else
    {
      ErrorMessage = "No se pudo reportar la publicación";
    }
  }

  private async Task ReportarComentario(int comentarioID)
  {
    Reportes nuevoReporte = new Reportes
      {
        UsuarioID = int.Parse(Id ?? "0"), // Suponiendo que Id es el ID del usuario actual
        ComentarioID = comentarioID
      };

    var response = await ReportesClient.CreateReporteAsync(nuevoReporte);

    if (response.IsSuccessStatusCode)
    {
      // Actualizar el estado del comentario para mostrar la banderita roja
      var comentario = comentariosData.FirstOrDefault(c => c.ComentarioID == comentarioID);
      if (comentario != null)
      {
        comentario.Reportado = true;
      }
    }
    else
    {
      ErrorMessage = "No se pudo reportar el comentario";
    }
  }

  private async Task EliminarReportePublicacion()
  {
    var response = await ReportesClient.DeleteReporteByPublicacionAsync(int.Parse(publicacion ?? "0"), int.Parse(Id ?? "0"));
    if (response.IsSuccessStatusCode)
    {
      // Actualizar el estado de la publicación para mostrar la banderita blanca
      publicacionData.Reportada = false;
    }
    else
    {
      ErrorMessage = "No se pudo eliminar el reporte de la publicación";
    }
  }

  private async Task EliminarReporteComentario(int comentarioID)
  {
    var response = await ReportesClient.DeleteReporteByComentarioAsync(comentarioID, int.Parse(Id ?? "0"));
    if (response.IsSuccessStatusCode)
    {
      // Actualizar el estado del comentario para mostrar la banderita blanca
      var comentario = comentariosData.FirstOrDefault(c => c.ComentarioID == comentarioID);
      if (comentario != null)
      {
        comentario.Reportado = false;
      }
    }
    else
    {
      ErrorMessage = "No se pudo eliminar el reporte del comentario";
    }
  }
}
