@page "/grupos/{id}"
@page "/grupos/"
@using Staticaly.Client.Data
@using Staticaly.Client.Models
@inject NavigationManager NavigationManager
@inject EquiposClient equiposClient

<PageTitle>Grupos - Staticaly</PageTitle>
<div class="z-40 fixed top-0 w-full">
  <NavBar id="@Id" />
</div>

<div
  class="pt-11 pl-0 lg:pl-20 lg:pt-0 text-white flex flex-col justify-center md:justify-normal text-center items-center">
  @if (string.IsNullOrEmpty(Id))
  {
    <div class="h-screen absolute inset-0 flex justify-center items-center bg-black bg-opacity-50 z-20">
      <div class="flex flex-col items-center bg-red-600 p-6 rounded-lg">
        <img src="/images/prohibido.svg" alt="Acceso denegado" class="w-32 h-32" />
        <h2 class="text-xl font-bold">Para acceder a esta pagina debes estar registrado</h2>
        <button
          class="bg-white hover:bg-gray-300 transition duration-300 text-red-600 font-bold py-2 px-4 rounded-lg mt-4"
          @onclick='() => NavigationManager.NavigateTo("/registro")'>Registrarse</button>
      </div>
    </div>
  }
  else
  {

    <div class="h-screen flex flex-col justify-center items-center text-primary-50">
      @if (gruposUsuario.Count == 0)
      {
        <div class="mt-4">
          <h2 class="text-2xl font-bold">No perteneces a ningun grupo</h2>
          <p>Unete a un grupo para poder ver sus publicaciones</p>
        </div>
      }
      @foreach (var grupo in gruposUsuario)
      {
        <div class="w-64 md:w-[500px] flex flex-col items-center bg-primary-400 p-6 rounded-lg m-4">
          <h2 class="text-2xl font-bold">@grupo.Nombre</h2>
          <p>@grupo.Descripcion</p>
          <button class="bg-primary-500 hover:bg-primary-600 font-bold py-2 px-4 rounded-lg mt-2 transition duration-300"
            @onclick='() => NavigationManager.NavigateTo($"/{Userid}/{grupo.EquipoID}", forceLoad:true)'>Acceder al
            grupo</button>
          @if (grupo.TipoEquipoID != 3)
          {
            <button class="bg-red-600 hover:bg-red-700 font-bold py-2 px-4 rounded-lg mt-2 transition duration-300"
              @onclick='() => SalirDelGrupo(grupo.EquipoID)'>Salir del grupo</button>
          }
        </div>
      }
      <div class="fixed bottom-0 right-0 mr-4 mb-4">
        <button @onclick='() => NavigationManager.NavigateTo($"/crear-grupo/{Userid}")'
          class="bg-primary-500 inline-flex items-center justify-center hover:bg-primary-700 text-white font-bold py-2 px-2 rounded-full md:rounded-md transition duration-300 text-center">
          <img src="Images/plus.svg" alt="Crear Publicación" class="h-6 w-6 inline-block" />
          <span class="ml-2 md:inline hidden">Crear Grupo</span>
        </button>
      </div>
    </div>
  }
</div>

@code {
  [Parameter] public string? Id { get; set; }
  int Userid;
  private List<Equipos> gruposUsuario = new List<Equipos>();

  protected override async Task OnInitializedAsync()
  {
    if (!string.IsNullOrEmpty(Id))
    {
      Userid = int.Parse(Id);
      var usuarioEquipos = await equiposClient.GetEquiposFromUsuarioAsync(Userid);

      if (usuarioEquipos != null && usuarioEquipos.Any())
      {
        gruposUsuario.AddRange(usuarioEquipos.Select(ue => ue.Equipo).Where(e => e != null).Cast<Equipos>());
      }
    }
  }

  private async Task SalirDelGrupo(int grupoId)
  {
    // Eliminar al usuario del grupo
    await equiposClient.DeleteUsuarioFromEquipoAsync(Userid, grupoId);

    // Obtener la lista de usuarios restantes en el grupo
    var usuariosEnGrupo = await equiposClient.GetUsuariosFromEquipoAsync(grupoId);

    // Verificar si la lista de usuarios está vacía
    if (usuariosEnGrupo.Length == 0)
    {
      // Si no hay usuarios en el grupo, eliminar el grupo
      var response = await equiposClient.DeleteEquipoAsync(grupoId);
      if (response.IsSuccessStatusCode)
      {
        // Redirigir al usuario a la página de grupos
        NavigationManager.NavigateTo($"/grupos/{Userid}", forceLoad: true);
      }
      else
      {
        // Manejar el error si la eliminación del grupo falla
        // Puedes mostrar un mensaje de error o realizar alguna otra acción
        Console.WriteLine("Error al eliminar el grupo.");
      }
    }
    else
    {
      // Si todavía hay usuarios en el grupo, redirigir al usuario a la página de grupos
      NavigationManager.NavigateTo($"/grupos/{Userid}", forceLoad: true);
    }
  }
}
