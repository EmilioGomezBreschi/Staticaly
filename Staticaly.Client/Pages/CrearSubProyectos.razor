@page "/crear-subproyecto/{Userid}/{Equipoid}/{Proyectoid}"
@using Models;
@using Data;
@using System.Text.Json;
@using System.Data;
@using System.IO;
@using NPOI.XSSF.UserModel;
@using NPOI.SS.UserModel;
@inject NavigationManager NavigationManager
@inject UsuariosClient UsuariosClient
@inject SubProyectosClient subProyectosClient
@inject DatosSubProyectosClient datosSubProyectosClient

<PageTitle>Crear SubProyecto - Staticaly</PageTitle>

<div class="text-white flex flex-col justify-center items-center px-24">
  @if (isLoading)
  {
    <div class="h-full absolute inset-0 flex justify-center items-center bg-black bg-opacity-50 z-50">
      <svg class="animate-spin h-8 w-8 text-primary-500" xmlns="http://www.w3.org/2000/svg" fill="none"
        viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647zM20 12a8 8 0 01-8 8v4c6.627 0 12-5.373 12-12h-4zm-2-5.291A7.962 7.962 0 0120 12h4c0-3.042-1.135-5.824-3-7.938l-3 2.647z">
        </path>
      </svg>
    </div>
  }
  <div id="logo" class="text-center md:mt-8 mb-4">
    <img src="images/heart.svg" class="w-24 h-24 mx-auto" alt="Logo de Statica.ly" />
    <h1 class="text-3xl text-logo-text">Statica.ly</h1>
  </div>
  <div class="bg-primary-300 rounded-lg p-8 w-auto h-full m-7">
    <EditForm Model="@SubProyecto" OnValidSubmit="NuevoGrupo" class="flex flex-col text-primary-400">
      @if (errorMessage != "")
      {
        <div class="relative mt-1 text-xs text-center bg-red-500 font-bold text-white px-4 py-2 rounded-md mb-4">
          @errorMessage
        </div>
      }
      <div class="relative my-3 bg-primary-100 rounded-md font-bold">
        <InputText @bind-Value="@SubProyecto.Titulo" type="text" id="nombre"
          class="w-full h-12 border-2 border-Primary-Background rounded-md pl-12 pr-4 placeholder-primary-400 bg-transparent"
          placeholder="Titulo Subproyecto" />
        <ValidationMessage For="@(() => SubProyecto.Titulo)" class="text-red-500" />
        <img src="images/info.svg" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-6 h-6"
          alt="Icono Grupo" />
      </div>
      <div class="relative my-3 bg-primary-100 rounded-md font-bold">
        <InputTextArea @bind-Value="@SubProyecto.Descripcion" type="text" id="descripcion"
          class="w-full h-24 md:h-60 border-2 border-Primary-Background rounded-md p-3 placeholder-primary-400 bg-transparent"
          placeholder="Descripcion (Opcional)" />
        <ValidationMessage For="@(() => SubProyecto.Descripcion)" class="text-red-500" />
      </div>
      <div class="relative flex flex-row justify-between items-center w-full h-full">
        <button type="button"
          class="bg-primary-500 text-white font-bold text-lg rounded-md h-20 md:h-16 w-32 mx-1 hover:bg-red-600 transition duration-300"
          @onclick='() => NavigationManager.NavigateTo($"/subproyectos/{Userid}/{Equipoid}/{Proyectoid}")'>Cancelar</button>
        <button type="submit"
          class="bg-primary-500 text-white font-bold text-lg rounded-md h-20 md:h-16 w-32 mx-1 hover:bg-primary-600 transition duration-300">Crear</button>
      </div>
    </EditForm>
    <h2 class="text-2xl text-center text-primary-400 mt-4">Importar datos</h2>
    <InputFile OnChange="@ImportExcelFile" class="mt-4" />

    <table class="table-auto w-full">
      <thead>
        <tr>
          @foreach (DataColumn column in dt.Columns)
          {
            <th class="border px-4 py-2">@column.ColumnName</th>
          }
        </tr>
      </thead>
      <tbody>
        @foreach (DataRow row in dt.Rows)
        {
          <tr>
            @foreach (DataColumn column in dt.Columns)
            {
              <td class="border px-4 py-2">@row[column]</td>
            }
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@code {
  [Parameter] public string? Userid { get; set; }
  [Parameter] public string? Proyectoid { get; set; }
  [Parameter] public string? Equipoid { get; set; }
  private Models.SubProyectos SubProyecto = new Models.SubProyectos();
  private User usuario = new User();
  int idUsuario;
  int IdProyecto;
  int SubproyectoID; // Nuevo campo para almacenar el ID del subproyecto
  private bool isLoading = false;
  private string errorMessage = "";
  DataTable dt = new DataTable();
  public static List<string> Nombres = new List<string>();
  public static List<string> Valores = new List<string>(); // Nueva lista para valores

  private void SetErrorMessage(string message)
  {
    errorMessage = message;
  }

  protected override Task OnInitializedAsync()
  {
    if (!string.IsNullOrEmpty(Userid))
    {
      idUsuario = int.Parse(Userid);
      return Task.CompletedTask;
    }
    return Task.CompletedTask;
  }

  private async Task NuevoGrupo()
  {
    if (SubProyecto.Titulo == null)
    {
      SetErrorMessage("Todos los campos son obligatorios");
      return;
    }
    isLoading = true;
    if (idUsuario == 0)
    {
      SetErrorMessage("Error al obtener el usuario");
      isLoading = false;
      return;
    }
    if (Proyectoid == null)
    {
      SetErrorMessage("Error al obtener el proyecto");
      isLoading = false;
      return;
    }
    IdProyecto = int.Parse(Proyectoid);

    // Crear el subproyecto
    SubProyecto = new Models.SubProyectos
      {
        Titulo = SubProyecto.Titulo,
        Descripcion = SubProyecto.Descripcion,
        UsuarioID = idUsuario,
        ProyectoID = IdProyecto
      };

    // Crear el subproyecto y obtener el SubproyectoID
    var result = await subProyectosClient.CreateSubProyectoAsync(SubProyecto);

    if (result != null)
    {
      // Obtener el SubproyectoID
      SubproyectoID = result.SubproyectoID;

      // Guardar datos en la base de datos
      await GuardarDatosEnBaseDeDatos(Nombres, Valores);
      NavigationManager.NavigateTo($"/subproyectos/{Userid}/{Equipoid}/{Proyectoid}");
    }
    else
    {
      SetErrorMessage("Error al crear el subproyecto");
      isLoading = false;
    }
  }

  private async Task GuardarDatosEnBaseDeDatos(List<string> nombres, List<string> valores)
  {
    if (nombres.Count != valores.Count)
    {
      SetErrorMessage("La cantidad de nombres y valores no coincide");
      return;
    }

    for (int i = 0; i < nombres.Count; i++)
    {
      var datosSubProyecto = new DatosSubProyecto
        {
          Nombre = nombres[i],
          Cantidad = int.Parse(Valores[i]), // Asegúrate de que DatosSubProyecto tenga una propiedad "Valor"
          SubproyectoID = SubproyectoID
        };

      var response = await datosSubProyectosClient.CreateDatosSubProyectoAsync(datosSubProyecto);
      if (!response.IsSuccessStatusCode)
      {
        SetErrorMessage("Error al guardar los datos en la base de datos");
        return;
      }
    }
  }

  async Task ImportExcelFile(InputFileChangeEventArgs e)
  {
    var fileStream = e.File.OpenReadStream();
    var ms = new MemoryStream();
    await fileStream.CopyToAsync(ms);
    fileStream.Close();
    ms.Position = 0;

    ISheet sheet;
    var xsswb = new XSSFWorkbook(ms);

    sheet = xsswb.GetSheetAt(0);
    IRow hr = sheet.GetRow(0);
    var rl = new List<string>();

    int cc = hr.LastCellNum;
    for (var j = 0; j < cc; j++)
    {
      ICell cell = hr.GetCell(j);
      dt.Columns.Add(cell.ToString());
    }

    for (var j = (sheet.FirstRowNum + 1); j <= sheet.LastRowNum; j++)
    {
      var r = sheet.GetRow(j);
      for (var i = r.FirstCellNum; i < cc; i++)
      {
        rl.Add(r.GetCell(i).ToString());
      }
      if (rl.Count > 0)
      {
        dt.Rows.Add(rl.ToArray());
      }
      rl.Clear();
    }

    Nombres.Clear();
    Valores.Clear();

    foreach (DataRow row in dt.Rows)
    {
      foreach (DataColumn col in dt.Columns)
      {
        var celda = row[col.ColumnName];
        var columna = col.ColumnName;

        if (columna == "Nombre")
        {
          Nombres.Add(celda.ToString());
        }
        else
        {
          Valores.Add(celda.ToString());
        }
      }
    }
  }
}
