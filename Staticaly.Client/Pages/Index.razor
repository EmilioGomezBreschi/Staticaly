@page "/{id}/{equipo}"
@page "/{id}"
@page "/"
@using Models
@using Data
@using System.Net.Http
@inject NavigationManager NavigationManager
@inject UsuariosClient UsuariosClient
@inject EquiposClient EquiposClient
@inject PublicacionesClient PublicacionesClient
@inject ComentariosClient ComentariosClient

<PageTitle>Foro - Staticaly</PageTitle>

<div class="z-40 fixed top-0">
  <NavBar Id="@Id" Equipo="@Equipo" />
</div>

<div class="pt-16 lg:pl-20 lg:pt-0 text-primary-100 flex flex-col justify-normal text-center items-center">

  <div class="flex flex-col items-center my-2 p-3 bg-primary-800 rounded-md text-white">
    @if (equipo == null)
    {
      <h2 class="text-2xl font-bold">Este es un equipo que no existe</h2>
    }
    else
    {
      <h2 class="text-2xl font-bold">@equipo.Nombre</h2>
    }
  </div>
  <div class="w-full max-w-72 md:max-w-md mt-4  text-black">
      <input type="text" @oninput="BuscarPublicaciones" placeholder="Buscar publicaciones..." class="w-full px-4 py-2 rounded-md border border-gray-300 focus:outline-none focus:border-primary-500" />
  </div>

  <div class="h-full flex flex-col justify-center items-center">
  @if (Publicaciones == null || Publicaciones.Count <= 0)
  {
      <h3 class="text-lg font-bold">No hay publicaciones en este grupo</h3>
  }
  else
  {
<div class="rounded-md p-4">
    <ul>
    @foreach (var publicacion in Publicaciones)
    {
      <div class="text-center w-full h-full bg-primary-300 mt-5 rounded-md">
        <div  @onclick="() => IrAPublicacion(publicacion.PublicacionID)" class="hover:cursor-pointer flex flex-col p-2">
            <h2 class="text-center font-bold text-2xl text-primary-600">@publicacion.Titulo</h2>
            <div class="mt-1 px-3 flex flex-row justify-around">
                <div class="text-center flex flex-col mr-5">
                    <p class="font-bold text-primary-500">@publicacion.Usuario?.Nombre</p>
                    <p class="font-light">@publicacion.Usuario?.Rango?.NombreRango</p>
                </div>
                <div class="flex flex-col w-full md:w-96 max-w-[600px]">
                    <p class="text-justify w-full mr-5 mb-4 text-wrap break-words">@publicacion.Contenido</p>
                    @if (publicacion.Imagen != null)
                    {
                        <img src="data:image;base64,@(Convert.ToBase64String(publicacion.Imagen))" alt="Foto seleccionada"
                        class="max-w-[430px] max-h-[430px]" />
                    }
                </div>
            </div>

            @if (ComentariosPorPublicacion != null && ComentariosPorPublicacion.ContainsKey(publicacion.PublicacionID))
            {
                var comentariosPublicacion = ComentariosPorPublicacion[publicacion.PublicacionID];
                <div class="mt-4">
                    @foreach (var comentario in comentariosPublicacion.Take(3))
                    {
                      <div class="mt-2 bg-primary-500 rounded-md p-5">
                        <div class="flex flex-row">
                          <div class="mr-2">
                            @if (comentario.Usuario != null && comentario.Usuario.Rango != null)
                            {
                              <p class="font-semibold text-primary-900 text-left">@comentario.Usuario.Nombre</p>
                              <p class="font-light text-left">@comentario.Usuario.Rango.NombreRango</p>
                            }
                            else
                            {
                              <p class="text-left font-semibold text-primary-900">Anónimo</p>
                            }
                          </div>
                          <div class="flex flex-col w-full max-w-[550px] md:w-96 ml-2">
                            @{
                                var contenidoCorto = comentario?.Contenido?.Length > 200 ? comentario.Contenido.Substring(0, 200) + "..." : comentario?.Contenido;
                            }
                            <p class="text-justify text-wrap break-words">@contenidoCorto</p>
                            @if (comentario?.Imagen != null)
                            {
                              <img src="data:image;base64,@(Convert.ToBase64String(comentario.Imagen))" alt="Foto seleccionada"
                                class="max-w-[430px] max-h-[430px]" />
                            }
                          </div>
                        </div>
                        <div class="flex justify-start">
                            @if (comentario?.Calificacion != null)
                            {
                                for (int i = 1; i <= 5; i++)
                                {
                                    <span class="text-yellow-500 inline-block">@((i <= comentario.Calificacion) ? "★" : "☆")</span>
                                }
                            }
                        </div>
                      </div>
                    }
                </div>
            }
            <p class="text-left mt-2">@publicacion.Fecha.ToString("dd/MM/yyyy")</p>
      </div>
            @if (publicacion.Usuario?.UsuarioID == usuario?.UsuarioID)
            {
              <button @onclick="()=>BorrarPublicacion(publicacion.PublicacionID)" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded-md mb-4 transition duration-300">Eliminar</button>
            }
        </div>
    }
    </ul>
    <div class="mt-4 flex justify-evenly">
        <button @onclick="IrAPaginaAnterior" class="bg-primary-500 text-white font-bold py-2 px-4 rounded-md">◄-</button>
        <span>Página @PaginaActual de @TotalPaginas</span>
        <button @onclick="IrAPaginaSiguiente" class="bg-primary-500 text-white font-bold py-2 px-4 rounded-md">-►</button>
    </div>
</div>

  }

</div>

  @if (usuario != null)
  {
    <div class="fixed bottom-0 right-0 mr-4 mb-4 text-right">
      @if (equipoId != 1)
      {
      <button @onclick="MostrarListaUsuarios"
        class="bg-primary-500 hover:bg-primary-700 text-white font-bold py-2 px-2 rounded-md transition duration-300 mb-2 block text-center">
        <span class="md:inline hidden">@((MostrarUsuarios) ? "Ocultar lista de usuarios" : "Mostrar lista de usuarios")</span>
        <span class="md:hidden inline">Usuarios</span>
      </button>
      }
      @if (usuario != null && EquipoUsuario != null && (equipoId==1 || EquipoUsuario.Any(u=>u.UsuarioID == usuario.UsuarioID && u.PermisoID != 2)))
      {
      <button @onclick="CrearPublicacion"
        class="bg-primary-500 inline-flex items-center justify-center hover:bg-primary-700 text-white font-bold py-2 px-2 rounded-full md:rounded-md transition duration-300 text-center">
        <img src="Images/plus.svg" alt="Crear Publicación" class="h-6 w-6 inline-block" />
        <span class="ml-2 md:inline hidden">Nueva publicación</span>
      </button>
      }
    </div>
  }

</div>


<div class="bg-primary-200 text-primary-900 font-semibold flex flex-col items-center p-4 rounded-md shadow-md right-0 top-0 mr-4 mt-24 z-30 @(MostrarUsuarios ? "fixed" : "hidden")">

  @if (EquipoUsuario != null && EquipoUsuario.Count > 1 && equipoId != 1)
  {
        <div class=" max-h-72 overflow-y-auto rounded-md p-4">
          <h3 class="text-lg font-bold mb-2">Usuarios del grupo</h3>
          <ul>
            @foreach (var usuarioEquipo in EquipoUsuario)
            {
              <div class="text-center bg-primary-300 mt-1 rounded-md px-3">
                <div>@(usuarioEquipo.Usuario?.Nombre ?? "Unknown User") @(usuarioEquipo.Usuario?.Apellido ?? "Unknown User")
                </div>
                <div>@(usuarioEquipo.Usuario?.Rango?.NombreRango ?? "Unknown Rango")</div>
              </div>
            }
          </ul>
        </div>
  }
  else
  {
    <div class="text-center">
      <h3 class="text-lg font-bold mb-2">Tu</h3>
    </div>
  }
  @if (usuario != null && EquipoUsuario != null && EquipoUsuario.Any(u=>u.UsuarioID == usuario.UsuarioID && u.PermisoID == 1))
  {
      <button @onclick="AgregarUsuario" class="bg-primary-500 hover:bg-primary-700 text-white font-bold py-2 px-2 rounded-md transition duration-300 text-center mt-3">
          Agregar usuario
      </button>
      if (EquipoUsuario.Count > 1)
      {
      <button @onclick="EditarPermisos" class="bg-primary-500 hover:bg-primary-700 text-white font-bold py-2 px-2 rounded-md transition duration-300 text-center mt-3">
          Editar permisos
      </button>
      }
  }


</div>


@code {
  [Parameter] public string? Id { get; set; }
  [Parameter] public string? Equipo { get; set; }
  int equipoId;
  private int PaginaActual = 1;
  private int TotalPaginas = 1;
  private const int PublicacionesPorPagina = 3;
  private User? usuario;
  private Equipos? equipo;
  private List<UsuariosEquipos>? EquipoUsuario = new List<UsuariosEquipos>();
  private List<Publicaciones>? Publicaciones = null;
  private Dictionary<int, Comentarios[]> ComentariosPorPublicacion = new Dictionary<int, Comentarios[]>();
  private bool MostrarUsuarios = false;


  protected override async Task OnInitializedAsync()
  {
      if (!string.IsNullOrEmpty(Id))
      {
          int.TryParse(Id, out int userId);
          usuario = await UsuariosClient.GetUsuarioAsync(userId);
      }

      int.TryParse(Equipo, out equipoId);

      // Si no se proporciona un ID de equipo en la URL, establecer el ID de equipo predeterminado como "1"
      if (string.IsNullOrEmpty(Equipo))
      {
          equipoId = 1;
      }

      // Obtener el equipo correspondiente al ID proporcionado
      equipo = await EquiposClient.GetEquipoByIdAsync(equipoId);

      // Verificar si el equipo existe
      if (equipo != null)
      {
          // Obtener todos los usuarios del grupo
          EquipoUsuario = (await EquiposClient.GetUsuariosFromEquipoAsync(equipoId)).ToList();
          await CargarPublicaciones();
      }
  }

  private async Task BuscarPublicaciones(ChangeEventArgs e)
  {
      // Obtener el término de búsqueda del evento
      string terminoBusqueda = e.Value?.ToString() ?? string.Empty;

      // Llamar al método para cargar publicaciones con el término de búsqueda
      await CargarPublicaciones(terminoBusqueda);
  }
private async Task CargarPublicaciones(string? terminoBusqueda = null)
{
    var resultado = await PublicacionesClient.ObtenerPublicaciones(PaginaActual, PublicacionesPorPagina, equipoId, terminoBusqueda);
    if (resultado != null)
    {
        Publicaciones = resultado.Publicaciones;
        TotalPaginas = resultado.TotalPaginas;
        // Si hay al menos una publicación, cargar los comentarios de todas las publicaciones de manera asincrónica
        if (Publicaciones != null && Publicaciones.Count > 0)
        {
            foreach (var publicacion in Publicaciones)
            {
                await CargarComentariosAsync(publicacion.PublicacionID);
            }
        }
    }
}

private async Task CargarComentariosAsync(int publicacionId)
{
    var comentarios = await ComentariosClient.GetComentariosAsync(publicacionId);
    ComentariosPorPublicacion[publicacionId] = comentarios;
}

private async Task IrAPaginaAnterior()
    {
        if (PaginaActual > 1)
        {
            PaginaActual--;
            await CargarPublicaciones();
        }
    }

    private async Task IrAPaginaSiguiente()
    {
        if (PaginaActual < TotalPaginas)
        {
            PaginaActual++;
            await CargarPublicaciones();
        }
    }

  private void CrearPublicacion()
  {
    NavigationManager.NavigateTo($"/CrearPublicacion/{Id}/{equipoId}");
  }

  private void AgregarUsuario()
  {
    NavigationManager.NavigateTo($"/AgregarUsuario/{Id}/{equipoId}");
  }

  private void EditarPermisos()
  {
    NavigationManager.NavigateTo($"/EditarPermisos/{Id}/{equipoId}");
  }

  private void IrAPublicacion(int publicacionId)
  {
      if (Id != null)
      {
          NavigationManager.NavigateTo($"/Publicacion/{publicacionId}/{Id}");
      }
      else
      {
          NavigationManager.NavigateTo($"/Publicacion/{publicacionId}");
      }
  }

  private async Task BorrarPublicacion(int publicacionId)
  {
    await PublicacionesClient.DeletePublicacionAsync(publicacionId);
    await CargarPublicaciones();
  }

  private void MostrarListaUsuarios()
  {
    MostrarUsuarios = !MostrarUsuarios;
  }
}
