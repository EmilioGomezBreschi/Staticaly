@page "/subproyectos/{Id}/{Equipo}/{Proyecto}"
@using Staticaly.Client.Data
@using Staticaly.Client.Models
@inject NavigationManager NavigationManager
@inject EquiposClient equiposClient
@inject UsuariosClient usuariosClient
@inject SubProyectosClient subProyectosClient

<PageTitle>SubProyectos - Staticaly</PageTitle>
<div class="z-40 fixed top-0 w-full">
  <NavBar Id="@Id" Equipo="@Equipo" />
</div>

<div
  class="pt-11 pl-0 lg:pl-20 lg:pt-0 text-white flex flex-col justify-center md:justify-normal text-center items-center">

  <div class="h-full flex flex-col justify-center items-center text-primary-50">
    <h1 class="text-4xl font-bold mt-3">SubProyectos</h1>
    @if (SubProyectos.Count == 0)
    {
      <div class="mt-4">
        <h2 class="text-2xl font-bold">Este Proyecto no cuenta con ningun Subproyecto</h2>
        <p>Crea un proyecto para visualizarlo aqui</p>
      </div>
    }
    @foreach (var subproyecto in SubProyectos)
    {
      <div class="w-64 md:w-[500px] flex flex-col items-center bg-primary-400 p-6 rounded-lg m-4">
        <h2 class="text-2xl font-bold">@subproyecto.Titulo</h2>
        <p>@subproyecto.Descripcion</p>
        <button class="bg-primary-500 hover:bg-primary-600 font-bold py-2 px-4 rounded-lg mt-2 transition duration-300"
          @onclick='() => NavigationManager.NavigateTo($"/Procesamiento/{Userid}/{Equipoid}/{subproyecto.SubproyectoID}", forceLoad:true)'>Entrar
          al
          subproyecto</button>
        @if (subproyecto.UsuarioID == Userid)
        {
          <button class="bg-red-600 hover:bg-red-700 font-bold py-2 px-4 rounded-lg mt-2 transition duration-300"
            @onclick='() => EliminarProyecto(subproyecto.SubproyectoID)'>Eliminar SubProyecto</button>
        }
      </div>
    }
    @if (SubProyectos.Count < 20)
    {
      <div class="fixed bottom-0 right-0 mr-4 mb-4">
        <button @onclick='() => NavigationManager.NavigateTo($"/crear-subproyecto/{Userid}/{Equipoid}/{Proyectoid}")'
          class="bg-primary-500 inline-flex items-center justify-center hover:bg-primary-700 text-white font-bold py-2 px-2 rounded-full md:rounded-md transition duration-300 text-center">
          <img src="Images/plus.svg" alt="Crear Publicación" class="h-6 w-6 inline-block" />
          <span class="ml-2 md:inline hidden">Crear SubProyecto</span>
        </button>
      </div>
    }
  </div>
</div>

@code {
  [Parameter] public string? Id { get; set; }
  [Parameter] public string? Proyecto { get; set; }
  [Parameter] public string? Equipo { get; set; }
  int Userid;
  int Equipoid;
  int Proyectoid;
  private List<Models.SubProyectos> SubProyectos { get; set; } = new List<Models.SubProyectos>();

  protected override async Task OnInitializedAsync()
  {
    if (!string.IsNullOrEmpty(Proyecto) && !string.IsNullOrEmpty(Id) && !string.IsNullOrEmpty(Equipo))
    {
      Userid = int.Parse(Id);
      Equipoid = int.Parse(Equipo);
      Proyectoid = int.Parse(Proyecto);
      await LoadSubProyectos();
    }
  }

  private async Task LoadSubProyectos()
  {
    var subproyectos = await subProyectosClient.GetSubProyectosAsync(Proyectoid);
    if (subproyectos != null)
    {
      SubProyectos = subproyectos.ToList();
    }
  }

  private async Task EliminarProyecto(int subproyectoId)
  {

    var result = await subProyectosClient.DeleteSubProyectoAsync(subproyectoId);
    if (result != null)
    {
      await LoadSubProyectos();
    }

  }
}
