@page "/ejercicios/{Id}/{Equipo}"
@page "/ejercicios/{id}"
@page "/ejercicios"
@using Models
@using Data
@using System.Net.Http
@using System.IO
@using OfficeOpenXml
@using NPOI.XSSF.UserModel
@using NPOI.SS.UserModel
@inject NavigationManager NavigationManager
@inject EjerciciosClient EjerciciosClient
@inject UsuariosClient UsuariosClient
@inject EquiposClient EquiposClient
@inject EjerciciosRespuestasClient EjerciciosRespuestasClient
@inject IJSRuntime JSRuntime

<PageTitle>Ejercicios - Staticaly</PageTitle>

<div class="z-40 fixed top-0">
  <NavBar Id="@Id" Equipo="@Equipo" />
</div>

<div
  class="pt-11 pl-0 lg:pl-20 lg:pt-0 text-white flex flex-col justify-center md:justify-normal text-center items-center">
  @if (string.IsNullOrEmpty(Id))
  {
    <div class="h-screen absolute inset-0 flex justify-center items-center bg-black bg-opacity-50 z-20">
      <div class="flex flex-col items-center bg-red-600 p-6 rounded-lg">
        <img src="/images/prohibido.svg" alt="Acceso denegado" class="w-32 h-32" />
        <h2 class="text-xl font-bold">Para acceder a esta pagina debes estar registrado</h2>
        <button
          class="bg-white hover:bg-gray-300 transition duration-300 text-red-600 font-bold py-2 px-4 rounded-lg mt-4"
          @onclick='() => NavigationManager.NavigateTo("/registro")'>Registrarse</button>
      </div>
    </div>
  }
  else
  {
    <div class="flex flex-col justify-center text-primary-50">
      <h1 class="text-4xl font-bold mt-3">Ejercicios</h1>
      @if (EjerciciosDelGrupo.Count > 0)
      {
        <div class="flex flex-col items-center mt-3 p-3">
          @foreach (var ejercicio in EjerciciosDelGrupo)
          {
            <div class="bg-primary-500 rounded-lg p-4 w-full lg:w-96 m-auto flex flex-col items-center mt-6">
              <h2 class="text-2xl font-bold text-primary-800 mb-2">@ejercicio.Titulo</h2>
              <p class="text-primary-50 mb-2">@ejercicio.Descripcion</p>
              @if (ejercicio.UsuarioID != 1)
              {
                <p class="text-sm font-light">Por: @ejercicio.User?.Nombre @ejercicio.User?.Apellido</p>
              }
              @if (ejercicio.UsuarioID == Convert.ToInt32(Id))
              {
                <div class="flex flex-row w-full justify-between">
                  @if (ejercicio.Publicado == false)
                  {
                    <button @onclick='() => PublicarEjercicios(ejercicio.EjerciciosID)'
                      class="bg-green-500 hover:bg-green-600 text-white w-24 font-bold py-2 px-4 rounded-lg mt-4 transition duration-300">
                      Publicar
                    </button>
                  }
                  <button @onclick='() => EliminarEjercicio(ejercicio.EjerciciosID)'
                    class="bg-red-500 hover:bg-red-600 text-white w-24 font-bold py-2 px-4 rounded-lg mt-4 transition duration-300">
                    Eliminar
                  </button>
                  <button @onclick='() => ExportarRespuestasAExcel(ejercicio.EjerciciosID, ejercicio.Titulo)'
                    class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded-lg mt-4 transition duration-300">
                    Exportar Respuestas
                  </button>
                </div>
              }
              else
              {
                <button
                  @onclick='() => NavigationManager.NavigateTo($"/responder-Ejercicio/{ejercicio.EjerciciosID}/{Id}/{EquipoId}")'
                  class="bg-primary-700 hover:bg-primary-800 text-white font-bold py-2 px-4 rounded-lg mt-4 transition duration-300">
                  Responder
                </button>
              }

            </div>
          }
        </div>
      }
      @if (user != null && UsuariosEquipos != null && equipo?.TipoEquipoID == 3 && UsuariosEquipos.Any(u => u.UsuarioID == Convert.ToInt32(Id) && u.PermisoID == 1))
      {
        <div class="fixed bottom-0 right-0 mr-4 mb-4">
          <button @onclick='() => NavigationManager.NavigateTo($"/crear-Ejercicio/{Id}/{EquipoId}")'
            class="bg-primary-500 inline-flex items-center justify-center hover:bg-primary-700 text-white font-bold py-2 px-2 rounded-full md:rounded-md transition duration-300 text-center">
            <img src="Images/plus.svg" alt="Crear Publicación" class="h-6 w-6 inline-block" />
            <span class="ml-2 md:inline hidden">Crear ejercicio</span>
          </button>
        </div>
      }
    </div>
  }
</div>

@code {
  [Parameter] public string? Id { get; set; }
  [Parameter] public string? Equipo { get; set; }
  public int EquipoId;
  private User? user;
  private Equipos? equipo = new Equipos();
  private List<UsuariosEquipos> UsuariosEquipos = new List<UsuariosEquipos>();
  public List<Models.Ejercicios> EjerciciosDelGrupo = new List<Models.Ejercicios>();


  protected override async Task OnInitializedAsync()
  {
    if (!string.IsNullOrEmpty(Id))
    {
      if (string.IsNullOrEmpty(Equipo))
      {
        EquipoId = 1;
      }
      else
      {
        EquipoId = int.Parse(Equipo);
      }
      user = await UsuariosClient.GetUsuarioAsync(int.Parse(Id));
      equipo = await EquiposClient.GetEquipoByIdAsync(EquipoId);
      UsuariosEquipos = (await EquiposClient.GetUsuariosFromEquipoAsync(EquipoId)).ToList();
      await CargarEjerciciosGrupo();
    }
  }

  // Método para cargar los Ejercicios del grupo
  private async Task CargarEjerciciosGrupo()
  {
    // Lógica para cargar los Ejercicios del grupo
    var ejercicios = await EjerciciosClient.ObtenerEjerciciosPorEquipoAsync(EquipoId);

    // Filtrar los ejercicios no publicados para usuarios que no son el creador
    if (user?.UsuarioID != null)
    {
      var usuarioId = user.UsuarioID;
      EjerciciosDelGrupo = ejercicios.Where(c => c.Publicado || c.UsuarioID == usuarioId).ToList();
    }
    else
    {
      // Si no hay usuario autenticado, solo mostrar ejercicios publicados
      EjerciciosDelGrupo = ejercicios.Where(c => c.Publicado).ToList();
    }
  }

  // Método para eliminar un Ejercicio
  private async Task EliminarEjercicio(int id)
  {
    var result = await EjerciciosClient.EliminarEjercicioAsync(id);
    if (result != null)
    {
      await CargarEjerciciosGrupo();
    }
  }

  // Método para publicar un Ejercicio
  private async Task PublicarEjercicios(int id)
  {
    var result = await EjerciciosClient.ActualizarEstadoEjercicioAsync(id, "true");
    if (result != null)
    {
      await CargarEjerciciosGrupo();
    }
  }

  // Método para exportar respuestas a Excel
  private async Task ExportarRespuestasAExcel(int ejercicioId, string ejercicioTitulo)
  {
    // Obtener las respuestas del ejercicio
    var respuestas = await EjerciciosRespuestasClient.ObtenerEjerciciosRespuestasPorEjercicioAsync(ejercicioId);

    // Crear un nuevo libro de Excel
    var workbook = new XSSFWorkbook();
    var sheet = workbook.CreateSheet("Respuestas");

    // Escribir los encabezados de las columnas
    var headerRow = sheet.CreateRow(0);
    headerRow.CreateCell(0).SetCellValue("Nombre");
    headerRow.CreateCell(1).SetCellValue("Pregunta");
    headerRow.CreateCell(2).SetCellValue("Respuesta");
    headerRow.CreateCell(3).SetCellValue("Correcta");
    headerRow.CreateCell(4).SetCellValue("Puntos");

    // Escribir los datos de las respuestas en el archivo Excel
    int rowIndex = 1;
    foreach (var respuesta in respuestas)
    {
      var row = sheet.CreateRow(rowIndex++);
      row.CreateCell(0).SetCellValue(respuesta.User?.Nombre + " " + respuesta.User?.Apellido);
      row.CreateCell(1).SetCellValue(respuesta.EjerciciosPreguntas?.Pregunta);
      row.CreateCell(2).SetCellValue(respuesta.Respuesta);
      row.CreateCell(3).SetCellValue(respuesta.Correcta.HasValue ? respuesta.Correcta.Value ? "Sí" : "No" : "");
      row.CreateCell(4).SetCellValue(respuesta.Puntos);
    }

    // Guardar el libro de Excel en un MemoryStream
    using (var memoryStream = new MemoryStream())
    {
      workbook.Write(memoryStream);
      var excelBytes = memoryStream.ToArray();

      // Convertir el byte array a base64
      var base64 = Convert.ToBase64String(excelBytes);

      // Descargar el archivo Excel utilizando la función JavaScript
      await JSRuntime.InvokeVoidAsync("downloadFile", $"{ejercicioTitulo}_Staticaly.xlsx", base64);
    }
  }



  private async Task BlazorDownloadFile(MemoryStream stream, string fileName)
  {
    var base64 = Convert.ToBase64String(stream.ToArray());
    await JSRuntime.InvokeVoidAsync("downloadFile", fileName, base64);
  }
}
