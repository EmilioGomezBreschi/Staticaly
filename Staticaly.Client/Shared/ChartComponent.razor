@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop

<canvas id="@canvasId"></canvas>

@code {
  [Parameter] public string ChartId { get; set; } = "myChart";
  [Parameter] public string ChartType { get; set; } = "bar"; // or 'line', 'pie', etc.
  [Parameter] public List<string> Labels { get; set; } = new List<string>();
  [Parameter] public List<int> Data { get; set; } = new List<int>();
  [Parameter] public List<int> LineData { get; set; } = new List<int>(); // Agrega esto para la línea del histograma
  [Parameter] public List<ScatterData> ScatterData { get; set; } = new List<ScatterData>();

  [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

  private string canvasId => ChartId + "_canvas";

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      if (ChartType == "histogram")
      {
        await JSRuntime.InvokeVoidAsync("renderHistogram", canvasId, Labels, Data, LineData);
      }
      else if (ChartType == "scatter")
      {
        await JSRuntime.InvokeVoidAsync("renderScatterChart", canvasId, Labels, ScatterData);
      }
      else
      {
        await JSRuntime.InvokeVoidAsync("renderChart", canvasId, ChartType, Labels, Data);
      }
    }
  }
}
