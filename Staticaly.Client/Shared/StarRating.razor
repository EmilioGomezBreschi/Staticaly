@using Microsoft.AspNetCore.Components

<div class="star-rating">
  @for (int i = 1; i <= MaxStars; i++)
  {
    <span class="text-yellow-500 inline-block">@((i <= Rating) ? "★" : "☆")</span>
  }
</div>


@code {
  [Parameter]
  public int MaxStars { get; set; } = 5;

  [Parameter]
  public float? Rating { get; set; }
}
